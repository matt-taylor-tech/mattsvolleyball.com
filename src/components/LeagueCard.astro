---
import type { RegCard } from '../lib/registration';

interface Props {
  day: string;
  format: string;
  description: string;
  details: string[];
  highlight?: string;
  price?: string;
  registrationUrl?: string;
  registrationKnown?: boolean;
  link?: { href: string; label: string };
  regEntries?: RegCard[];
}

const { day, format, description, details, highlight, price, registrationUrl = 'https://app.teamlinkt.com/register/find/mattsvolleyball', registrationKnown = false, link, regEntries } = Astro.props;
const hasRegEntries = regEntries && regEntries.length > 0;

const dayColors: Record<string, string> = {
  Monday: 'from-emerald-600 to-emerald-700',
  Tuesday: 'from-coral-500 to-coral-600',
  Wednesday: 'from-ocean-500 to-ocean-600',
  Thursday: 'from-sand-500 to-sand-600',
};

const gradientClass = dayColors[day] || 'from-ocean-500 to-ocean-600';
---

<div class="card flex flex-col" data-league-day={day.toLowerCase()}>
  <!-- Header -->
  <div class={`bg-gradient-to-r ${gradientClass} p-6 text-white`}>
    <div class="flex items-start justify-between">
      <div>
        <h3 class="font-display font-extrabold text-2xl">{day}</h3>
        <p class="text-white/90 font-semibold">{format}</p>
      </div>
      {price && (
        <div class="text-right">
          <span class="font-display font-extrabold text-2xl">{price}</span>
          <p class="text-white/70 text-xs">per player</p>
        </div>
      )}
    </div>
  </div>

  <!-- Body -->
  <div class="p-6 flex-1 flex flex-col">
    <p class="text-ocean-700 mb-4 leading-relaxed">
      {description}
      {link && (
        <a href={link.href} class="text-ocean-500 hover:text-ocean-700 font-medium transition-colors"> {link.label}</a>
      )}
    </p>

    {highlight && (
      <div class="bg-sand-100 border-l-4 border-coral-500 px-4 py-3 rounded-r-lg mb-4">
        <p class="text-sm text-ocean-700 font-medium">{highlight}</p>
      </div>
    )}

    <ul class="space-y-2 mb-6 flex-1">
      {details.map((detail) => (
        <li class="flex items-start gap-2 text-sm text-ocean-600/80">
          <svg class="w-5 h-5 text-ocean-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          {detail}
        </li>
      ))}
    </ul>

    <!-- Registration CTA -->
    <div class="reg-cta space-y-3">
      {hasRegEntries ? (
        regEntries.map((entry) => {
          const label = entry.name.replace(/^(tuesday|wednesday|thursday)\s+4v4\s*/i, '').trim() || entry.name;
          return entry.isOpen ? (
            <div>
              <a href={entry.regUrl} target="_blank" rel="noopener noreferrer" class="btn-primary text-center w-full block">
                Sign Up – {label}
              </a>
              <p class="text-xs text-ocean-600/70 text-center mt-1">
                {entry.daysLeft} day{entry.daysLeft !== 1 ? 's' : ''} left · Closes {entry.closeDate}
              </p>
            </div>
          ) : entry.isFuture ? (
            <div>
              <span class="block text-center w-full py-2 rounded-lg bg-sand-200 text-ocean-600/70 font-semibold text-sm">{label} – Coming Soon</span>
              <p class="text-xs text-ocean-600/70 text-center mt-1">Opens {entry.openDate}</p>
            </div>
          ) : (
            <div>
              <span class="block text-center w-full py-2 rounded-lg bg-sand-200 text-ocean-600/70 font-semibold text-sm">{label} – Closed</span>
            </div>
          );
        })
      ) : registrationKnown ? (
        <span class="block text-center w-full py-2 rounded-lg bg-sand-200 text-ocean-600/70 font-semibold text-sm">
          Registration Closed
        </span>
      ) : (
        <a
          href={registrationUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary text-center w-full"
          data-cta-type="sign-up"
        >
          Sign Up for {day} Now
        </a>
      )}
    </div>
  </div>
</div>
