---
import { Trophy } from '@lucide/astro';
import { Picture, inferRemoteSize } from 'astro:assets';

interface Props {
  teamName: string;
  season: string;
  year: number;
  day: string;
  division: string;
  photo?: string;
  /** Rendered width of the card, for picking a photo size. Defaults to the champions page grid. */
  sizes?: string;
}

const {
  teamName, season, year, day, division, photo,
  sizes = '(min-width: 1024px) 390px, (min-width: 640px) 50vw, 100vw',
} = Astro.props;
const r2Base = import.meta.env.PUBLIC_R2_BASE_URL || '';
const src = photo ? `${r2Base}${photo}` : '';
const alt = `${teamName} - ${season} ${year} Champions`;
const imgClass = 'w-full h-full object-cover motion-safe:group-hover:scale-105 motion-safe:transition-transform motion-safe:duration-300';

// Resize and convert the photo at build time (image.domains in astro.config.mjs).
// A photo that can't be downloaded then would fail the whole build, so check
// it here first and serve the original from R2 if it's unreachable.
let size: { width: number; height: number } | null = null;
if (src && r2Base) {
  try {
    size = await inferRemoteSize(src);
  } catch (err) {
    console.warn(`[champions] Could not read ${src} - serving it unoptimized:`, err);
  }
}
const maxWidth = size?.width ?? 0;
const widths = [300, 400, 600, 800, 1200].filter((w) => w <= maxWidth);
if (!widths.length && maxWidth) widths.push(maxWidth);
---

<div class="card group">
  <!-- Photo -->
  {photo ? (
    <div class="aspect-square overflow-hidden">
      {size ? (
        <Picture
          src={src}
          width={size.width}
          height={size.height}
          widths={widths}
          sizes={sizes}
          formats={['avif']}
          fallbackFormat="webp"
          alt={alt}
          class={imgClass}
          pictureAttributes={{ class: 'block w-full h-full' }}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <img
          src={src}
          alt={alt}
          width="600"
          height="600"
          class={imgClass}
          loading="lazy"
          decoding="async"
        />
      )}
    </div>
  ) : (
    <div class="aspect-square img-placeholder">
      <div class="text-center p-4">
        <svg class="w-12 h-12 mx-auto mb-2 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span class="text-sm font-medium">Team Photo</span>
      </div>
    </div>
  )}

  <!-- Info -->
  <div class="p-5">
    <div class="flex items-center gap-2 mb-2">
      <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-ocean-600 bg-sand-200 px-2.5 py-1 rounded-lg">
        <Trophy class="w-3.5 h-3.5" />
        Champions
      </span>
    </div>
    <h3 class="font-display font-bold text-lg text-ocean-600 mb-1">{teamName}</h3>
    <p class="text-sm text-ocean-600/60">
      {season} {year} &middot; {day} {division}
    </p>
  </div>
</div>
