---
import { Trophy } from 'lucide-astro';

interface Props {
  teamName: string;
  season: string;
  year: number;
  day: string;
  division: string;
  photo?: string;
}

const { teamName, season, year, day, division, photo } = Astro.props;
const r2Base = import.meta.env.PUBLIC_R2_BASE_URL || '';
---

<div class="card group">
  <!-- Photo -->
  {photo ? (
    <div class="aspect-square overflow-hidden">
      <img
        src={`${r2Base}${photo}`}
        alt={`${teamName} - ${season} ${year} Champions`}
        width="600"
        height="600"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
        decoding="async"
      />
    </div>
  ) : (
    <div class="aspect-square img-placeholder">
      <div class="text-center p-4">
        <svg class="w-12 h-12 mx-auto mb-2 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span class="text-sm font-medium">Team Photo</span>
      </div>
    </div>
  )}

  <!-- Info -->
  <div class="p-5">
    <div class="flex items-center gap-2 mb-2">
      <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-ocean-600 bg-sand-200 px-2.5 py-1 rounded-lg">
        <Trophy class="w-3.5 h-3.5" />
        Champions
      </span>
    </div>
    <h3 class="font-display font-bold text-lg text-ocean-600 mb-1">{teamName}</h3>
    <p class="text-sm text-ocean-600/60">
      {season} {year} &middot; {day} {division}
    </p>
  </div>
</div>
