---
interface Props {
  count?: number;
}

const { count = 12 } = Astro.props;
const placeholders = Array.from({ length: count }, (_, i) => i + 1);
---

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
  {placeholders.map((n) => (
    <div
      class="group relative aspect-square img-placeholder rounded-xl overflow-hidden cursor-pointer"
    >
      <div class="absolute inset-0 flex flex-col items-center justify-center p-4 text-center">
        <svg class="w-10 h-10 mb-2 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span class="text-xs font-medium opacity-40">Photo {n}</span>
      </div>
      <div class="absolute inset-0 bg-ocean-800/0 group-hover:bg-ocean-800/20 transition-colors duration-200" />
    </div>
  ))}
</div>
