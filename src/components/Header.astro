---
const r2Base = import.meta.env.PUBLIC_R2_BASE_URL || '';
const currentPath = Astro.url.pathname;

const navLinks = [
  { label: 'Home', href: '/' },
  {
    label: 'Leagues',
    href: '/leagues/',
    children: [
      { label: 'Leagues', href: '/leagues/' },
      { label: 'Schedule', href: '/leagues/schedule/' },
      { label: 'Teams', href: '/leagues/teams/' },
      { label: 'Standings', href: '/leagues/standings/' },
      { label: 'Scores', href: '/leagues/scores/' },
    ],
  },
  { label: 'Rules', href: '/rules/' },
  { label: 'Contact', href: '/contact/' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm shadow-sm">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 shrink-0">
        <img
          src={`${r2Base}/logos/vbenginelite.png`}
          alt="Matt's Volleyball"
          class="h-10 md:h-12 w-auto"
        />
        <span class="font-display font-bold text-ocean-600 text-lg md:text-xl hidden sm:block">
          Matt's Volleyball
        </span>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden lg:flex items-center gap-1">
        {navLinks.map((link) => (
          <div class="relative group">
            <a
              href={link.href}
              class:list={[
                'px-4 py-2 rounded-lg text-sm font-semibold transition-colors',
                isActive(link.href)
                  ? 'text-ocean-800 bg-sand-200'
                  : 'text-ocean-700 hover:text-ocean-800 hover:bg-sand-100',
              ]}
            >
              {link.label}
              {link.children && (
                <svg class="inline-block w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>
            {link.children && (
              <div class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                <div class="bg-white rounded-xl shadow-lg border border-sand-200 py-2 min-w-[180px]">
                  {link.children.map((child) => (
                    <a
                      href={child.href}
                      class="block px-4 py-2 text-sm text-ocean-700 hover:text-ocean-800 hover:bg-sand-50 transition-colors"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}

        <a
          href="https://app.teamlinkt.com"
          target="_blank"
          rel="noopener noreferrer"
          class="ml-2 text-sm font-semibold text-ocean-700 hover:text-ocean-800 px-4 py-2 rounded-lg transition-colors"
        >
          Account
        </a>

        <a
          href="https://app.teamlinkt.com/register/find/mattsvolleyball"
          target="_blank"
          rel="noopener noreferrer"
          class="ml-2 btn-primary !py-2 !px-6 !text-sm"
        >
          Sign Up
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 rounded-lg text-ocean-600 hover:bg-sand-100 transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="lg:hidden hidden pb-4">
      <div class="flex flex-col gap-1 pt-2 border-t border-sand-200">
        {navLinks.map((link) => (
          <>
            <a
              href={link.href}
              class:list={[
                'px-4 py-3 rounded-lg font-semibold transition-colors',
                isActive(link.href)
                  ? 'text-ocean-800 bg-sand-200'
                  : 'text-ocean-700 hover:text-ocean-800 hover:bg-sand-100',
              ]}
            >
              {link.label}
            </a>
            {link.children?.filter(c => c.href !== link.href).map((child) => (
              <a
                href={child.href}
                class="pl-8 pr-4 py-2 text-sm text-ocean-600/70 hover:text-ocean-800 transition-colors"
              >
                {child.label}
              </a>
            ))}
          </>
        ))}

        <a
          href="https://app.teamlinkt.com"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-3 text-ocean-700 hover:text-ocean-800 font-semibold transition-colors"
        >
          Account ↗
        </a>

        <a
          href="https://app.teamlinkt.com/register/find/mattsvolleyball"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary text-center mt-2"
        >
          Sign Up
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
    btn.setAttribute('aria-expanded', String(isOpen));
  });
</script>
