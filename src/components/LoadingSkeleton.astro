---
// Placeholder rows shown while a page's TeamLinkt data loads (issue #46).
// The page script hides it by id, the same way it hid the old spinner.
interface Props {
  id: string;
  /** Read by screen readers, e.g. "Loading schedule". */
  label: string;
  rows?: number;
  /** Grid classes matching the cards the data renders into. */
  gridClass?: string;
  /** Show a bar in place of the date or division heading above the rows. */
  heading?: boolean;
}

const { id, label, rows = 4, gridClass = 'grid gap-2', heading = true } = Astro.props;
---

<div id={id} role="status" class="motion-safe:animate-pulse">
  <span class="sr-only">{label}</span>
  {heading && <div class="h-5 w-40 rounded-full bg-sand-200 mb-3" aria-hidden="true"></div>}
  <div class={gridClass} aria-hidden="true">
    {Array.from({ length: rows }, () => (
      <div class="bg-white rounded-2xl shadow-md p-3 sm:p-4">
        <div class="h-3 w-24 rounded-full bg-sand-200"></div>
        <div class="mt-2.5 h-4 w-3/4 rounded-full bg-sand-200"></div>
      </div>
    ))}
  </div>
</div>
