---
// The three league nights. Reuses LeagueCard so the registration buttons
// (Sign Up / Coming Soon / Closed, per-division deep links, spots counter)
// are identical to the leagues page instead of a second copy of that logic.
import LeagueCard from './LeagueCard.astro';
import type { RegCard } from '../lib/registration';

interface Props {
  regByDay: Record<string, RegCard[]>;
  registrationKnown: boolean;
}

const { regByDay, registrationKnown } = Astro.props;
---

  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading text-center mb-12">Find Your Night</h2>
      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <LeagueCard
          day="Tuesday"
          format="4v4"
          price="$65"
          description="Requires 1 female minimum per team. Welcomes all skill levels, typically intermediate to competitive."
          highlight="Two divisions: recreational and competitive with separate playoff nights."
          registrationKnown={registrationKnown}
          regEntries={regByDay['tuesday']}
          details={[
            '6 regular season games over 6 weeks plus a division-specific playoff night',
            '1 game every week, no bye weeks',
            'Game times: 6:30, 7:30, or 8:30 PM',
            'Form your own team or join as individual',
            'All skill levels welcome',
          ]}
        />
        <LeagueCard
          day="Wednesday"
          format="Shuffle"
          price="$55"
          description="Social focus with volleyball secondary. Individual sign-ups with weekly team redrafts. Meet new people every week!"
          link={{ href: '/leagues/shuffle/', label: 'Learn how shuffle works →' }}
          highlight='Level Up format: winning teams advance and receive handicaps, keeping every match competitive.'
          registrationKnown={registrationKnown}
          regEntries={regByDay['wednesday']}
          details={[
            'Individual sign-ups. Teams re-drafted each week',
            'Free prize raffles between games — checking in is your entry',
            '6 weekly sessions plus playoffs',
            'Approximately 2-hour sessions',
            'All skill levels welcome',
          ]}
        />
        <LeagueCard
          day="Thursday"
          format="4v4"
          price="$65"
          description="Requires 1 female minimum per team. Welcomes all skill levels, typically intermediate to competitive."
          highlight="Two divisions: recreational and competitive with separate playoff nights."
          registrationKnown={registrationKnown}
          regEntries={regByDay['thursday']}
          details={[
            '6 regular season games over 6 weeks plus a division-specific playoff night',
            '1 game every week, no bye weeks',
            'Game times: 6:30, 7:30, or 8:30 PM',
            'Form your own team or join as individual',
            'All skill levels welcome',
          ]}
        />
      </div>
    </div>
  </section>
