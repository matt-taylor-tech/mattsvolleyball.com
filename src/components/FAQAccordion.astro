---
interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
// Native <details> works without JS and with find-in-page; a shared `name`
// keeps one answer open at a time in browsers that support it.
const group = 'faq';
---

<div class="space-y-3">
  {items.map((item) => (
    <details name={group} class="group border border-sand-200 rounded-xl overflow-hidden bg-white">
      <summary class="w-full flex items-center justify-between p-5 text-left font-semibold text-ocean-700 hover:text-ocean-500 transition-colors cursor-pointer list-none [&::-webkit-details-marker]:hidden">
        <span>{item.question}</span>
        <svg class="w-5 h-5 shrink-0 ml-4 motion-safe:transition-transform motion-safe:duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="px-5 pb-5">
        <p class="text-ocean-600/80 leading-relaxed">{item.answer}</p>
      </div>
    </details>
  ))}
</div>
