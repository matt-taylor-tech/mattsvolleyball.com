---
interface Props {
  label: string;
  items: string; // CSS selector for searchable items
  groups: string; // CSS selector for sections that hide when none of their items match
  class?: string;
}

const { label, items, groups, class: className = '' } = Astro.props;
---

<div class={className} data-page-search data-items={items} data-groups={groups}>
  <label class="block text-xs font-semibold uppercase tracking-wide text-ocean-500 mb-2" for="page-search-input">{label}</label>
  <input
    id="page-search-input"
    type="search"
    autocomplete="off"
    placeholder="Type to filter"
    class="w-full rounded-xl border border-sand-300 bg-white px-4 py-3 text-ocean-700 placeholder:text-ocean-600/50 focus:outline-none focus:border-ocean-500 focus:ring-2 focus:ring-ocean-500/30"
  />
  <p data-search-empty hidden class="mt-4 text-ocean-700">No matches. Try a different word.</p>
</div>

<style is:global>
  [data-nomatch] { display: none !important; }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-page-search]');
  const input = root?.querySelector<HTMLInputElement>('input');
  const empty = root?.querySelector<HTMLElement>('[data-search-empty]');

  if (root && input && empty) {
    const itemSelector = root.dataset.items!;
    const groups = Array.from(document.querySelectorAll<HTMLElement>(root.dataset.groups!));

    // Each item is searched together with the headings it sits under, so a
    // search for a section's title ("female", "substitutions") finds the
    // section even when its items never repeat the title.
    type Entry = { el: HTMLElement; text: string };
    type Sub = { heading: HTMLElement; items: HTMLElement[] };
    const index = groups.map((group) => {
      const entries: Entry[] = [];
      const subs: Sub[] = [];
      let h2 = '';
      let sub: Sub | null = null;
      group.querySelectorAll<HTMLElement>(`h2, h3, ${itemSelector}`).forEach((el) => {
        if (el.matches('h2')) {
          h2 = el.textContent ?? '';
          sub = null;
        } else if (el.matches('h3')) {
          sub = { heading: el, items: [] };
          subs.push(sub);
        } else {
          entries.push({ el, text: `${h2} ${sub?.heading.textContent ?? ''} ${el.textContent ?? ''}`.toLowerCase() });
          sub?.items.push(el);
        }
      });
      // Lists and tables that hold items, so one emptied by the search goes too.
      const containers = Array.from(group.querySelectorAll<HTMLElement>('ul, ol, table'))
        .filter((c) => c.querySelector(itemSelector));
      return { group, entries, subs, containers };
    });

    const showing = (el: HTMLElement) => !el.hidden && !el.hasAttribute('data-nomatch');

    const run = () => {
      const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      index.forEach(({ group, entries, subs, containers }) => {
        entries.forEach(({ el, text }) => {
          el.toggleAttribute('data-nomatch', !terms.every((t) => text.includes(t)));
        });
        subs.forEach(({ heading, items }) => {
          heading.toggleAttribute('data-nomatch', items.length > 0 && !items.some(showing));
        });
        containers.forEach((c) => {
          c.toggleAttribute('data-nomatch', !Array.from(c.querySelectorAll<HTMLElement>(itemSelector)).some(showing));
        });
        const any = entries.some(({ el }) => showing(el));
        group.toggleAttribute('data-nomatch', !any);
        if (any) shown++;
      });
      empty.hidden = shown > 0 || terms.length === 0;
      // Lets the page update anything that summarizes what's visible.
      document.dispatchEvent(new Event('page-search:done'));
    };

    input.addEventListener('input', run);
    // Other filters on the page can re-run the search after they change what's visible.
    document.addEventListener('page-search:refresh', run);
  }
</script>
