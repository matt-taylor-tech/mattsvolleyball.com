---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const r2Base = import.meta.env.PUBLIC_R2_BASE_URL || '';
const { title, description = "Matt's Volleyball - the hottest coed sand volleyball leagues in the Lake Norman area! Play year-round at Saeed's Bar & Grill in Cornelius and Blythe Landing in Huntersville." } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${r2Base}/logos/vbenginelite.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${r2Base}/logos/vbenginelite.png`} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/x-icon" href={`${r2Base}/favicon.ico`} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SportsOrganization",
      "name": "Matt's Volleyball",
      "url": "https://mattsvolleyball.com",
      "logo": `${r2Base}/logos/vbenginelite.png`,
      "description": "Coed sand volleyball leagues in the Lake Norman area. Play year-round at Saeed's Bar & Grill in Cornelius and Blythe Landing in Huntersville.",
      "sport": "Volleyball",
      "areaServed": ["Cornelius, NC", "Huntersville, NC", "Davidson, NC", "Mooresville, NC", "Lake Norman, NC", "Charlotte, NC"],
      "location": [
        {
          "@type": "SportsActivityLocation",
          "name": "Saeed's Bar & Grill",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "20832 Catawba Ave",
            "addressLocality": "Cornelius",
            "addressRegion": "NC",
            "postalCode": "28031",
            "addressCountry": "US"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 35.4842,
            "longitude": -80.8691
          }
        },
        {
          "@type": "SportsActivityLocation",
          "name": "Blythe Landing Park",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "15901 NC-73",
            "addressLocality": "Huntersville",
            "addressRegion": "NC",
            "postalCode": "28078",
            "addressCountry": "US"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 35.4351,
            "longitude": -80.9082
          }
        }
      ],
      "sameAs": [
        "https://www.facebook.com/groups/mattsvolleyball/",
        "https://instagram.com/mattsvolleyball/"
      ]
    })} />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script is:inline src="/scripts/update-registration-cta.js"></script>
  </body>
</html>
