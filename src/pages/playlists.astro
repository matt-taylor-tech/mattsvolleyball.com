      { title: 'All Hip Hop/Rap Mix', id: '3dCcp0lpMk2QpecFEzZBFm' },
      { title: 'Metal/Rock Mix', id: '6nR5FebRJSc3oCVIZsYn7m' },
    ],
  },
  {
    name: 'Hip Hop',
    playlists: [
      { title: 'Old School Hip Hop', id: '053wvc5njxC6kENqqPFW0z' },
      { title: 'HitforBrains Hip Hop', id: '4R4BCqXbUtAydZmHsKHoRa' },
      { title: '90s/00s Hip Hop', id: '0QtPQ3fW3RPmBGdlwTLfKl' },
    ],
  },
  {
    name: 'Rap',
    playlists: [
      { title: 'Lyrical Rap', id: '3Qo8DLqzSdviWmDUwTlNQc' },
      { title: 'LockedIn', id: '1Cwc8ckj42pBnud9ooAPAu' },
      { title: '90s/00s Rap', id: '2Ly4nHxHxVo2StoWWL8U2c' },
    ],
  },
  {
    name: 'Rock',
    playlists: [
      { title: 'Classic Rock', id: '0BzWaqwMVSzelZBDkSk4t5' },
      { title: 'Alternative Rock', id: '5MLNDnk4pR9AOKT4Cp77SZ' },
      { title: 'Hard Rock', id: '6EDL1lbef6nSFrQCPLC5Kf' },
    ],
  },
  {
    name: 'Metal',
    playlists: [
      { title: 'Melodic Metal', id: '1sBbMpv3ooLlbgfMK5kpJf' },
      { title: 'Power Metal', id: '37RVu4A3LRyDK4DnNNpbkk' },
      { title: 'Metal/Rock Mix', id: '6nR5FebRJSc3oCVIZsYn7m' },
    ],
  },
  {
    name: 'Other',
    playlists: [
      { title: 'HitforBrains Old School', id: '1OifrFOFZw7eg5wtOUwFtf' },
      { title: 'Ladies Night', id: '7ANuTzJaWSIlqsXJFeMtVc' },
      { title: 'Beach Music', id: '7L8vg8AcYmdBPZVHEvizN3' },
      { title: 'Trance', id: '1GxxWh4UcQ4pWFvI0PXaVC' },
      { title: 'Reggae', id: '0yf5lfJ2X2l1Qjn66CpGZQ' },
      { title: 'sui POP', id: '0zfBQYZR2tmKTbvliiMEOT' },
    ],
  },
];
---

<Layout title="Playlists | Matt's Volleyball" description="Curated music playlists for Matt's Volleyball game nights. The soundtrack to your sand volleyball experience.">
  <!-- Hero -->
  <PageHero title="Playlists" subtitle="The soundtrack to your sand volleyball experience." />

  <section class="py-12 md:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      {categories.map((category) => (
        <div class="mb-16 last:mb-0">
          <h2 class="section-heading mb-8">{category.name}</h2>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {category.playlists.map((playlist) => (
              <iframe
                title={playlist.title}
                src={`https://open.spotify.com/embed/playlist/${playlist.id}?utm_source=generator&theme=0`}
                width="100%"
                height="352"
                style="border:0"
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                loading="lazy"
                class="rounded-xl"
              />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>
