---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Playlists | Matt's Volleyball" description="Curated music playlists for Matt's Volleyball game nights. The soundtrack to your sand volleyball experience.">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-ocean-600 to-ocean-800 text-white py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display font-black text-4xl sm:text-5xl md:text-6xl mb-4">Playlists</h1>
      <p class="text-white/80 text-lg md:text-xl max-w-2xl mx-auto">
        The soundtrack to your sand volleyball experience.
      </p>
    </div>
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full mt-8">
      <path d="M0 40C360 80 720 0 1080 40C1260 60 1380 50 1440 40V80H0V40Z" fill="#F5F0EA" />
    </svg>
  </section>

  <section class="py-12 md:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-center text-ocean-600/70 mb-12 max-w-xl mx-auto">
        Groove to the beats courtside. Here are our curated playlists organized by genre.
      </p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { name: 'Mixes', emoji: '🎧', color: 'from-ocean-600 to-ocean-700' },
          { name: 'Hip Hop', emoji: '🎤', color: 'from-sand-400 to-sand-500' },
          { name: 'Rap', emoji: '🔥', color: 'from-coral-500 to-coral-600' },
          { name: 'Rock', emoji: '🎸', color: 'from-ocean-700 to-ocean-800' },
          { name: 'Metal', emoji: '🤘', color: 'from-ocean-800 to-ocean-900' },
          { name: 'Other', emoji: '🎵', color: 'from-ocean-500 to-ocean-700' },
        ].map((genre) => (
          <div class={`bg-gradient-to-br ${genre.color} rounded-2xl p-8 text-white text-center shadow-lg hover:shadow-xl transition-shadow`}>
            <span class="text-5xl mb-4 block">{genre.emoji}</span>
            <h2 class="font-display font-bold text-2xl">{genre.name}</h2>
            <p class="text-white/60 text-sm mt-2">Coming soon</p>
          </div>
        ))}
      </div>

      <p class="text-center text-ocean-600/50 mt-12 text-sm italic">
        Playlist links will be added soon. Check back for Spotify and Apple Music links.
      </p>
    </div>
  </section>
</Layout>
