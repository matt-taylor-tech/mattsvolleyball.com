---
import Layout from '../../layouts/Layout.astro';
import { Users } from 'lucide-astro';
import { DIVISIONS, DIVISION_IDS, ACTIVE_SEASON_LABEL } from '../../lib/seasonConfig';
---

<Layout title="Teams | Matt's Volleyball" description="View all teams across Matt's Volleyball leagues.">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-ocean-600 to-ocean-800 text-white pt-20 md:pt-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display font-black text-4xl sm:text-5xl md:text-6xl mb-4">Teams</h1>
      <p class="text-white/80 text-lg md:text-xl max-w-2xl mx-auto">
        All teams across every division.
      </p>
    </div>
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
      <path d="M0 40C360 80 720 0 1080 40C1260 60 1380 50 1440 40V80H0V40Z" fill="#F7F6F3" />
    </svg>
  </section>

  <section class="py-12 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-6 rounded-xl border border-sand-300 bg-sand-100/70 px-4 py-3 text-sm text-ocean-700">
        Showing team rosters from <span class="font-semibold">{ACTIVE_SEASON_LABEL}</span>.
      </div>

      <!-- Division Tabs -->
      <div class="flex flex-wrap gap-2 mb-8" id="division-tabs">
        {DIVISIONS.map((d, i) => (
          <button data-division={d.id} class={`tab-btn${i === 0 ? ' active' : ''}`}>{d.label}</button>
        ))}
      </div>

      <!-- Team Search -->
      <div class="mb-8">
        <input
          type="text"
          id="team-search"
          placeholder="Search by team name..."
          class="w-full sm:w-72 px-4 py-2 rounded-full border border-sand-300 text-ocean-700 placeholder:text-sand-500 focus:outline-none focus:border-ocean-500 focus:ring-1 focus:ring-ocean-500 text-sm"
        />
      </div>

      <!-- Loading State -->
      <div id="teams-loading" class="text-center py-12">
        <div class="inline-block w-8 h-8 border-4 border-sand-300 border-t-ocean-600 rounded-full animate-spin"></div>
        <p class="text-ocean-600/70 mt-3">Loading teams...</p>
      </div>

      <!-- Empty State -->
      <div id="teams-empty" class="text-center py-12 hidden">
        <Users class="w-12 h-12 text-sand-400 mx-auto mb-3" />
        <p class="text-ocean-600/70">No teams found.</p>
      </div>

      <!-- Teams Container -->
      <div id="teams-container" class="hidden"></div>

      <!-- Tailwind safelist for dynamically rendered classes -->
      <span class="hidden card p-5 sm:p-6 grid sm:grid-cols-2 lg:grid-cols-3 w-12 h-12 rounded-full object-cover bg-sand-100 text-ocean-500 text-ocean-700 text-ocean-600/70 font-display font-bold text-lg text-sm"></span>

    </div>
  </section>
</Layout>

<style>
  .tab-btn {
    @apply px-3 py-2 rounded-full text-xs sm:text-sm font-medium transition-colors;
    @apply bg-white text-ocean-600 border border-sand-300 hover:bg-sand-50;
  }
  .tab-btn.active {
    @apply bg-ocean-600 text-white border-ocean-600;
  }
</style>

<script>
  import { TEAMS_API_URL, DIVISION_IDS, ACTIVE_SEASON_ID } from '../../lib/seasonConfig';

  const API_URL = TEAMS_API_URL;
  let currentDivision = DIVISION_IDS[0];
  let currentTeams: Team[] = [];
  let searchQuery = '';

  interface Team {
    id: number;
    name: string;
    imageUrl: string;
    groups: string;
  }

  async function fetchTeams(divisionId: string): Promise<Team[]> {
    const body = new URLSearchParams();
    body.set('group_ids[division]', divisionId);
    body.set('season_id', ACTIVE_SEASON_ID);

    const res = await fetch(API_URL, { method: 'POST', body });
    return await res.json();
  }

  function render(teams: Team[]) {
    const container = document.getElementById('teams-container')!;
    const loading = document.getElementById('teams-loading')!;
    const empty = document.getElementById('teams-empty')!;

    loading.classList.add('hidden');

    if (teams.length === 0) {
      container.classList.add('hidden');
      empty.classList.remove('hidden');
      return;
    }

    empty.classList.add('hidden');
    container.classList.remove('hidden');

    container.innerHTML = `
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        ${teams.map((t) => `
          <a href="/leagues/team/?id=${t.id}&name=${encodeURIComponent(t.name)}" class="card p-5 sm:p-6 flex items-center gap-4 hover:shadow-md transition-shadow">
            <img src="${t.imageUrl}" alt="${t.name}" class="w-12 h-12 rounded-full object-cover bg-sand-100" />
            <div>
              <h3 class="font-display font-bold text-ocean-700">${t.name}</h3>
              <p class="text-sm text-ocean-600/70">${t.groups}</p>
            </div>
          </a>
        `).join('')}
      </div>
    `;
  }

  function filterAndRender() {
    const filtered = searchQuery
      ? currentTeams.filter((t) => t.name.toLowerCase().includes(searchQuery.toLowerCase()))
      : currentTeams;
    render(filtered);
  }

  async function loadTeams() {
    const loading = document.getElementById('teams-loading')!;
    const container = document.getElementById('teams-container')!;
    const empty = document.getElementById('teams-empty')!;

    loading.classList.remove('hidden');
    container.classList.add('hidden');
    empty.classList.add('hidden');

    try {
      currentTeams = await fetchTeams(currentDivision);
      filterAndRender();
    } catch {
      loading.classList.add('hidden');
      empty.classList.remove('hidden');
    }
  }

  // Tab clicks
  document.querySelectorAll<HTMLButtonElement>('#division-tabs .tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#division-tabs .tab-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      currentDivision = btn.dataset.division || DIVISION_IDS[0];
      loadTeams();
    });
  });

  // Team search
  const searchInput = document.getElementById('team-search') as HTMLInputElement;
  searchInput.addEventListener('input', () => {
    searchQuery = searchInput.value;
    filterAndRender();
  });

  // Initial load
  loadTeams();
</script>
