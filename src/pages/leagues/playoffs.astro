---
import LoadingSkeleton from '../../components/LoadingSkeleton.astro';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { Trophy } from '@lucide/astro';
import { ACTIVE_SEASON_LABEL } from '../../lib/seasonConfig';
---

<Layout title="Playoffs | Matt's Volleyball" description="Playoff brackets for Matt's Volleyball leagues - single elimination tournaments by division with separate playoff nights for recreational and competitive divisions.">
  <!-- Hero -->
  <PageHero class="print:hidden" title="Playoffs" subtitle="Single elimination brackets by division, with separate playoff nights for recreational and competitive leagues." />

  <section class="py-12 md:py-20 print:py-0">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-6 rounded-xl border border-sand-300 bg-sand-100/70 px-4 py-3 text-sm text-ocean-700 print:hidden">
        {ACTIVE_SEASON_LABEL} playoffs. Brackets update as results come in on playoff night.
      </div>

      <!-- Night / day tabs, filled in by the script -->
      <div class="flex flex-wrap gap-2 mb-6 print:hidden" id="group-tabs"></div>

      <div class="hidden md:flex justify-end mb-4 print:hidden" id="print-row">
        <button id="print-btn" class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-ocean-600 bg-white border border-sand-300 rounded-full hover:bg-sand-50 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          Print Brackets
        </button>
      </div>

      <LoadingSkeleton id="playoffs-loading" label="Loading brackets" rows={4} />

      <div id="playoffs-not-ready" class="text-center py-12 hidden">
        <Trophy class="w-12 h-12 text-sand-400 mx-auto mb-3" />
        <p class="text-ocean-700 font-display font-bold text-xl mb-2">Regular Season Still in Progress</p>
        <p class="text-ocean-600/70">Playoff brackets will be generated once all regular season games are complete.</p>
        <a href="/leagues/standings/" class="inline-block mt-4 text-sm font-medium text-ocean-600 hover:text-ocean-800 underline underline-offset-2">View Current Standings →</a>
      </div>

      <div id="brackets-container" class="hidden space-y-8"></div>

    </div>
  </section>
</Layout>

<style is:global>
  /* ── Bracket tree (desktop and print) ──
     Every round column is split into equal-height slots, one per match, so a
     match always sits centered between the two matches that feed it. Lines are
     drawn from the slots: a stub out of each match, a vertical joining each
     pair, and a stub into the next round. */
  .bk-tree {
    --bk-gap: 2.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(13rem, 1fr);
    column-gap: var(--bk-gap);
  }
  .bk-col-body {
    display: flex;
    flex-direction: column;
    min-height: calc(var(--bk-rows) * 6.75rem);
  }
  .bk-slot {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0.4rem 0;
  }
  .bk-col:not(:last-child) .bk-slot::after {
    content: '';
    position: absolute;
    right: calc(var(--bk-gap) / -2);
    width: calc(var(--bk-gap) / 2);
    height: 50%;
    border-color: theme('colors.sand.300');
    border-style: solid;
    border-width: 0;
    border-right-width: 2px;
  }
  .bk-col:not(:last-child) .bk-slot:nth-child(odd)::after { top: 50%; border-top-width: 2px; border-top-right-radius: 6px; }
  .bk-col:not(:last-child) .bk-slot:nth-child(even)::after { bottom: 50%; border-bottom-width: 2px; border-bottom-right-radius: 6px; }
  .bk-col:not(:first-child) .bk-slot::before {
    content: '';
    position: absolute;
    left: calc(var(--bk-gap) / -2);
    width: calc(var(--bk-gap) / 2);
    top: 50%;
    border-top: 2px solid theme('colors.sand.300');
  }

  @media print {
    @page { size: landscape; margin: 0.4in; }
    header, footer, nav { display: none !important; }
    body { background: white !important; }
    .bk-division { break-inside: avoid; break-before: page; box-shadow: none !important; }
    .bk-division:first-child { break-before: auto; }
    .bk-tree { --bk-gap: 1.75rem; }
  }
</style>

<script>
  import {
    DIVISIONS as ALL_DIVISIONS,
    STANDINGS_API_URL,
    EVENTS_API,
    ACTIVE_SEASON_ID,
    DAY_FULL_LABEL,
    PLAYOFFS_ACTIVE,
    etNowString,
  } from '../../lib/seasonConfig';
  import { escapeHtml } from '../../lib/html';
  import { fromEngine, project, currentRoundIndex, type Bracket, type BracketMatch, type BracketSide } from '../../lib/bracket';
  import { fetchPlayoffNights } from '../../lib/volleyballEngine';

  // Brackets from VolleyballEngine stay up this long after their night, so the
  // champion is still showing for a while after the season ends.
  const RECENT_DAYS = 21;
  const REFRESH_MS = 60_000;

  const DIVISIONS = ALL_DIVISIONS.filter((d) => d.hasPlayoffs);

  interface Group {
    key: string;
    label: string;
    /** The night's date (YYYY-MM-DD), for brackets from VolleyballEngine. */
    date: string | null;
    brackets: Bracket[];
    /** Regular-season records by team name, for projected brackets. */
    records: Map<string, string>;
  }

  let groups: Group[] = [];
  let currentGroup = '';
  // The round each bracket shows on a phone, once the visitor picks one.
  const pickedRound = new Map<string, number>();

  const todayKey = () => etNowString().slice(0, 10);

  function daysAgoKey(days: number): string {
    const [y, m, d] = todayKey().split('-').map(Number);
    return new Date(Date.UTC(y, m - 1, d - days)).toISOString().slice(0, 10);
  }

  function nightLabel(date: string): string {
    return new Date(`${date}T12:00:00Z`).toLocaleDateString('en-US', {
      weekday: 'short', month: 'short', day: 'numeric', timeZone: 'UTC',
    });
  }

  // ── Data ──────────────────────────────────────────────────────────────────

  async function engineGroups(): Promise<Group[]> {
    const nights = await fetchPlayoffNights(daysAgoKey(RECENT_DAYS));
    return nights
      .filter((night) => night.playoff_brackets.length > 0)
      .map((night) => ({
        key: night.id,
        label: nightLabel(night.event_date),
        date: night.event_date,
        brackets: [...night.playoff_brackets]
          .sort((a, b) => a.display_order - b.display_order)
          .map((b) => fromEngine(b, b.playoff_matches)),
        records: new Map(),
      }));
  }

  async function postForm(url: string, fields: Record<string, string>) {
    const res = await fetch(url, { method: 'POST', body: new URLSearchParams(fields) });
    if (!res.ok) throw new Error(`TeamLinkt returned ${res.status}`);
    return res.json();
  }

  async function regularSeasonOver(): Promise<boolean> {
    if (PLAYOFFS_ACTIVE) return true;
    const upcoming = await Promise.all(DIVISIONS.map((d) =>
      postForm(EVENTS_API, { start: '0', length: '1', status: 'upcoming', [`filters[${d.id}]`]: d.id })
        .then((json) => (json.data || []).length > 0)));
    return upcoming.every((has) => !has);
  }

  async function projectedGroups(): Promise<Group[]> {
    const divisions = await Promise.all(DIVISIONS.map(async (config) => {
      const json = await postForm(STANDINGS_API_URL, { 'group_ids[division]': config.id, season_id: ACTIVE_SEASON_ID });
      return { config, standings: (json.standings || []) as any[] };
    }));

    const byDay = new Map<string, Group>();
    for (const { config, standings } of divisions) {
      if (standings.length < 2) continue;
      // Every team makes the playoffs unless the division caps the field.
      const field = standings.slice(0, config.playoffTeamCount ?? standings.length);
      const group: Group = byDay.get(config.day) ?? {
        key: config.day, label: DAY_FULL_LABEL[config.day] ?? config.day, date: null, brackets: [], records: new Map(),
      };
      group.brackets.push(project(config.label, field.map((s, i) => ({ seed: i + 1, name: s.Team.name }))));
      for (const s of field) {
        group.records.set(s.Team.name, `${s.total_wins}-${s.total_losses}${s.total_ties > 0 ? `-${s.total_ties}` : ''}`);
      }
      byDay.set(config.day, group);
    }
    return [...byDay.values()];
  }

  /** Tonight's night, else the next one, else the most recent. Projected brackets open on the first night. */
  function defaultGroup(): string {
    const today = todayKey();
    const dated = groups.filter((g) => g.date);
    if (dated.length === 0) return groups[0]?.key ?? '';
    return (dated.find((g) => g.date === today) ?? dated.find((g) => g.date! > today) ?? dated[dated.length - 1]).key;
  }

  // ── Rendering ─────────────────────────────────────────────────────────────

  function sideRow(side: BracketSide, match: BracketMatch, records: Map<string, string>, setIndex: 0 | 1): string {
    const lost = match.state === 'final' && !side.won;
    const record = side.name ? records.get(side.name) : undefined;
    const sets = match.sets.map((s) =>
      `<span class="w-5 text-center ${s[setIndex] > s[1 - setIndex] ? 'text-ocean-700 font-semibold' : 'text-ocean-400'}">${s[setIndex]}</span>`).join('');
    return `
      <div class="flex items-center gap-2 px-2.5 py-1.5 ${side.won ? 'bg-coral-500/5 shadow-[inset_3px_0_0] shadow-coral-500' : ''}">
        <span class="w-5 shrink-0 text-center text-[11px] font-bold ${side.won ? 'text-coral-600' : 'text-ocean-400'}">${side.seed ?? ''}</span>
        <span class="flex-1 min-w-0 text-sm leading-tight ${side.name
          ? `${side.won ? 'font-bold text-ocean-800' : lost ? 'text-ocean-400' : 'font-semibold text-ocean-700'}`
          : 'italic text-ocean-400'}">${escapeHtml(side.name ?? side.placeholder)}${record
            ? ` <span class="text-[11px] font-normal text-ocean-400 tabular-nums">${escapeHtml(record)}</span>` : ''}</span>
        ${sets ? `<span class="flex text-xs tabular-nums">${sets}</span>` : ''}
        ${side.score !== null && match.state !== 'upcoming'
          ? `<span class="w-5 text-right text-sm font-bold tabular-nums ${side.won ? 'text-coral-600' : 'text-ocean-500'}">${side.score}</span>` : ''}
      </div>`;
  }

  function matchCard(match: BracketMatch, records: Map<string, string>): string {
    if (match.state === 'bye') {
      return `
        <div class="rounded-xl border border-dashed border-sand-300 bg-sand-50/60 px-2.5 py-2 flex items-center gap-2 text-sm">
          <span class="w-5 text-center text-[11px] font-bold text-ocean-400">${match.a.seed ?? ''}</span>
          <span class="flex-1 min-w-0 font-semibold text-ocean-600 leading-tight">${escapeHtml(match.a.name ?? '')}</span>
          <span class="text-[11px] uppercase tracking-wider text-ocean-400">Bye</span>
        </div>`;
    }
    const meta = [match.time, match.court].filter(Boolean).map((v) => escapeHtml(String(v))).join(' · ');
    const badge = match.state === 'live'
      ? '<span class="inline-flex items-center gap-1 rounded-full bg-coral-500 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white"><span class="w-1.5 h-1.5 rounded-full bg-white motion-safe:animate-pulse"></span>Live</span>'
      : match.state === 'final'
        ? '<span class="rounded-full bg-sand-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-ocean-500">Final</span>'
        : '';
    return `
      <div class="rounded-xl bg-white shadow-sm border ${match.state === 'live' ? 'border-coral-400 ring-1 ring-coral-400' : 'border-sand-200'} overflow-hidden">
        ${meta || badge ? `<div class="flex items-center justify-between gap-2 px-2.5 pt-1.5 text-[11px] font-medium text-ocean-500"><span>${meta}</span>${badge}</div>` : ''}
        <div class="divide-y divide-sand-100 py-0.5">
          ${sideRow(match.a, match, records, 0)}
          ${sideRow(match.b, match, records, 1)}
        </div>
      </div>`;
  }

  function championBanner(bracket: Bracket): string {
    if (!bracket.champion?.name) return '';
    return `
      <div class="mb-4 flex items-center gap-3 rounded-xl border border-coral-300 bg-white px-4 py-3">
        <svg class="w-7 h-7 shrink-0 text-coral-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4zM7 6H4v1a3 3 0 0 0 3 3M17 6h3v1a3 3 0 0 1-3 3"/>
        </svg>
        <div>
          <p class="text-[11px] font-bold uppercase tracking-wider text-coral-600">Champion</p>
          <p class="font-display font-bold text-lg text-ocean-800 leading-tight">${escapeHtml(bracket.champion.name)}</p>
        </div>
      </div>`;
  }

  /** Phone view: one round at a time, picked with tabs. */
  function roundView(bracket: Bracket, id: string, records: Map<string, string>): string {
    const open = pickedRound.get(id) ?? currentRoundIndex(bracket);
    const tabs = bracket.rounds.map((r, i) =>
      `<button type="button" class="tab-btn shrink-0${i === open ? ' active' : ''}" data-bracket="${id}" data-round="${i}">${escapeHtml(r.name)}</button>`).join('');
    const panels = bracket.rounds.map((r, i) => {
      const games = r.matches.filter((m) => m.state !== 'bye');
      const byes = r.matches.filter((m) => m.state === 'bye' && m.a.name);
      const thirdPlace = i === bracket.rounds.length - 1 && bracket.thirdPlace
        ? `<p class="mt-2 text-xs font-bold uppercase tracking-wider text-ocean-500">3rd Place</p>${matchCard(bracket.thirdPlace, records)}` : '';
      return `
        <div class="${i === open ? '' : 'hidden'} space-y-3" data-panel="${id}:${i}">
          ${games.map((m) => matchCard(m, records)).join('')}
          ${thirdPlace}
          ${byes.length ? `<p class="text-xs text-ocean-500">Bye${byes.length > 1 ? 's' : ''} to the ${escapeHtml(bracket.rounds[i + 1]?.name ?? 'next round')}: ${byes
            .map((m) => `<span class="font-semibold text-ocean-700">#${m.a.seed} ${escapeHtml(m.a.name ?? '')}</span>`).join(', ')}</p>` : ''}
        </div>`;
    }).join('');
    return `
      <div class="md:hidden print:hidden">
        <div class="flex gap-2 overflow-x-auto pb-1 mb-3 -mx-1 px-1">${tabs}</div>
        ${panels}
      </div>`;
  }

  /** Desktop and print view: the whole tree with connector lines. */
  function treeView(bracket: Bracket, records: Map<string, string>): string {
    const columns = bracket.rounds.map((r, i) => {
      const last = i === bracket.rounds.length - 1;
      return `
        <div class="bk-col">
          <p class="mb-1 text-center text-[11px] font-bold uppercase tracking-wider text-ocean-500">${escapeHtml(r.name)}</p>
          <div class="bk-col-body">
            ${r.matches.map((m) => `<div class="bk-slot">${matchCard(m, records)}</div>`).join('')}
          </div>
          ${last && bracket.thirdPlace ? `<p class="mt-4 mb-1 text-center text-[11px] font-bold uppercase tracking-wider text-ocean-500">3rd Place</p>${matchCard(bracket.thirdPlace, records)}` : ''}
        </div>`;
    }).join('');
    return `
      <div class="hidden md:block print:block overflow-x-auto pb-2">
        <div class="bk-tree" style="--bk-rows: ${bracket.rounds[0].matches.length}">${columns}</div>
      </div>`;
  }

  function render() {
    const tabs = document.getElementById('group-tabs')!;
    tabs.innerHTML = groups.length > 1
      ? groups.map((g) => `<button type="button" class="tab-btn${g.key === currentGroup ? ' active' : ''}" data-group="${escapeHtml(g.key)}">${escapeHtml(g.label)}</button>`).join('')
      : '';

    const group = groups.find((g) => g.key === currentGroup);
    const container = document.getElementById('brackets-container')!;
    if (!group) {
      container.innerHTML = '';
      return;
    }
    container.innerHTML = group.brackets.map((bracket, i) => {
      const id = `${group.key}-${i}`;
      return `
        <div class="bk-division rounded-2xl border border-sand-200 bg-white/70 p-3 sm:p-5 shadow-sm">
          <div class="flex flex-wrap items-center gap-2 mb-4">
            <h2 class="font-display font-bold text-xl text-ocean-700">${escapeHtml(bracket.title)}</h2>
            ${bracket.projected ? '<span class="rounded-full border border-sand-300 bg-sand-50 px-2.5 py-0.5 text-xs font-medium text-ocean-500">Projected from standings</span>' : ''}
            ${group.date ? `<span class="hidden print:inline text-sm text-ocean-500">${escapeHtml(group.label)}</span>` : ''}
          </div>
          ${championBanner(bracket)}
          ${roundView(bracket, id, group.records)}
          ${treeView(bracket, group.records)}
        </div>`;
    }).join('');
  }

  function showState(state: 'loading' | 'not-ready' | 'brackets') {
    document.getElementById('playoffs-loading')!.classList.toggle('hidden', state !== 'loading');
    document.getElementById('playoffs-not-ready')!.classList.toggle('hidden', state !== 'not-ready');
    document.getElementById('brackets-container')!.classList.toggle('hidden', state !== 'brackets');
    document.getElementById('print-row')!.classList.toggle('md:flex', state === 'brackets');
  }

  // ── Events ────────────────────────────────────────────────────────────────

  document.getElementById('group-tabs')!.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-group]');
    if (!btn) return;
    currentGroup = btn.dataset.group!;
    render();
  });

  document.getElementById('brackets-container')!.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-round]');
    if (!btn) return;
    const id = btn.dataset.bracket!;
    const round = Number(btn.dataset.round);
    pickedRound.set(id, round);
    btn.parentElement!.querySelectorAll('.tab-btn').forEach((b) => b.classList.toggle('active', b === btn));
    document.querySelectorAll<HTMLElement>(`[data-panel^="${CSS.escape(id)}:"]`).forEach((panel) => {
      panel.classList.toggle('hidden', panel.dataset.panel !== `${id}:${round}`);
    });
  });

  document.getElementById('print-btn')?.addEventListener('click', () => window.print());

  // ── Start ─────────────────────────────────────────────────────────────────

  async function load(): Promise<'engine' | 'projected' | 'not-ready'> {
    // VolleyballEngine is the source of truth once a night is set up there.
    try {
      const fromEngineNights = await engineGroups();
      if (fromEngineNights.length > 0) {
        groups = fromEngineNights;
        return 'engine';
      }
    } catch (error) {
      console.error('Could not load playoff brackets from VolleyballEngine:', error);
    }
    if (!(await regularSeasonOver())) return 'not-ready';
    groups = await projectedGroups();
    return groups.length > 0 ? 'projected' : 'not-ready';
  }

  async function init() {
    showState('loading');
    let source: Awaited<ReturnType<typeof load>>;
    try {
      source = await load();
    } catch {
      showState('not-ready');
      return;
    }
    if (source === 'not-ready') {
      showState('not-ready');
      return;
    }
    currentGroup = defaultGroup();
    showState('brackets');
    render();

    // On a playoff night, keep the bracket current while the page is open.
    if (source === 'engine' && groups.some((g) => g.date === todayKey())) {
      setInterval(async () => {
        if (document.visibilityState !== 'visible') return;
        try {
          const fresh = await engineGroups();
          if (fresh.length > 0) {
            groups = fresh;
            render();
          }
        } catch {
          // Keep showing the last good bracket.
        }
      }, REFRESH_MS);
    }
  }

  init();
</script>
