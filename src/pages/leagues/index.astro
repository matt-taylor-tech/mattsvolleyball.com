---
import Layout from '../../layouts/Layout.astro';
import LeagueCard from '../../components/LeagueCard.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const faqItems = [
  {
    question: 'What equipment do I need?',
    answer: 'Bring athletic attire suitable for playing in sand. Mikasa volleyballs are provided, but you\'re welcome to bring your own.',
  },
  {
    question: 'Is it beginner-friendly?',
    answer: 'Absolutely! Matt\'s Volleyball caters to players of all skill levels, including beginners. We have recreational divisions specifically designed for newer players.',
  },
  {
    question: 'How do I form a team?',
    answer: 'You can create your own team and invite friends, or sign up as an individual and we\'ll place you on a team. Either way, you\'ll have a great time.',
  },
  {
    question: 'Can I join multiple teams?',
    answer: 'Yes! You can join multiple teams across different league nights. We do our best to avoid scheduling conflicts when possible.',
  },
  {
    question: 'What time are the games?',
    answer: 'Choose your weekly day. Games start at 6:30, 7:30, 8:30, or 9:30 PM. You\'ll receive your specific game time before the season starts.',
  },
  {
    question: 'Is there an age requirement?',
    answer: 'Players must be at least 21 years old to participate in our leagues.',
  },
  {
    question: 'How much does it cost?',
    answer: '$65 per player for Tuesday or Thursday, $55 per player for Wednesday, plus credit card processing fees. That covers the full regular season plus playoffs.',
  },
  {
    question: 'Are spectators allowed?',
    answer: 'Spectators are welcome and encouraged! Come out, grab some food and drinks, and enjoy the matches.',
  },
  {
    question: 'What happens with bad weather?',
    answer: 'We have an inclement weather / rainout policy. Check our rules page or your TeamLinkt app for updates on any schedule changes.',
  },
];
---

<Layout title="Leagues | Matt's Volleyball" description="Sand volleyball leagues for all skill levels in Lake Norman. Tuesday & Thursday 4v4 leagues, Wednesday shuffle league. Sign up today!">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-ocean-600 to-ocean-800 text-white py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display font-black text-4xl sm:text-5xl md:text-6xl mb-4">Leagues</h1>
      <p class="text-white/80 text-lg md:text-xl max-w-2xl mx-auto">
        Volleyball for grownups who don't take themselves too seriously.
      </p>
    </div>
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full mt-8">
      <path d="M0 40C360 80 720 0 1080 40C1260 60 1380 50 1440 40V80H0V40Z" fill="#F7F6F3" />
    </svg>
  </section>

  <!-- Season Info (dynamic from TeamLinkt) -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Loading state -->
      <div id="season-loading">
        <div class="inline-block w-6 h-6 border-3 border-sand-300 border-t-ocean-600 rounded-full animate-spin mb-4"></div>
        <h2 class="section-heading">Loading season info...</h2>
      </div>
      <!-- Dynamic content injected here -->
      <div id="season-info" class="hidden"></div>
    </div>
  </section>

  <!-- Registration Cards (dynamic) -->
  <section id="reg-section" class="pb-8 hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h3 class="font-display font-extrabold text-2xl text-ocean-600 text-center mb-8">Registration</h3>
      <div id="reg-cards" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
    </div>
  </section>

  <!-- Tailwind safelist for dynamic registration classes -->
  <span class="hidden bg-sand-200 text-ocean-700 bg-ocean-500 bg-ocean-600 bg-coral-500 bg-sand-500 text-white text-white/90 text-ocean-600/70 text-ocean-600 inline-flex items-center gap-2 rounded-lg font-bold font-semibold text-sm text-xs animate-pulse w-2 h-2 rounded-full px-4 py-2 py-3 p-4 mb-6 card overflow-hidden font-display flex-col gap-3 flex justify-between btn-primary text-center w-full !py-2 block underline hover:text-ocean-700 section-heading mb-1"></span>

  <!-- League Cards -->
  <section class="pb-16 md:pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-3 gap-8">
        <LeagueCard
          day="Tuesday"
          format="4v4"
          price="$65"
          description="Maximum 14 teams. Requires 1 female minimum per team. Welcomes all skill levels, typically intermediate to competitive."
          highlight="Two divisions: recreational and competitive with separate playoffs."
          details={[
            '6 regular season games over 6-7 weeks plus 1 playoff week',
            '1 game weekly plus 1 bye week',
            'Form your own team or join as individual',
            'All skill levels welcome',
          ]}
        />

        <LeagueCard
          day="Wednesday"
          format="4v4 Shuffle"
          price="$55"
          description="Social focus with volleyball secondary. Individual sign-ups with weekly team redrafts. Meet new people every week!"
          highlight='Level Up format: winning teams advance and receive handicaps, keeping every match competitive.'
          details={[
            'Individual sign-ups. Teams re-drafted each week',
            '7 regular season games plus 1 playoff week',
            'Approximately 2-hour sessions',
            'All skill levels welcome',
          ]}
        />

        <LeagueCard
          day="Thursday"
          format="4v4"
          price="$65"
          description="Maximum 14 teams. Identical structure to Tuesday league with 1 female minimum requirement."
          highlight="Two competitive divisions with separate playoffs."
          details={[
            '6 regular season games over 6-7 weeks plus 1 playoff week',
            '1 game weekly plus 1 bye week',
            'Form your own team or join as individual',
            'All skill levels welcome',
          ]}
        />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading text-center mb-12">Frequently Asked Questions</h2>
      <FAQAccordion items={faqItems} />
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-sand-200">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-3xl text-ocean-600 mb-4">
        Ready to play?
      </h2>
      <p class="text-ocean-600/80 text-lg mb-8">
        Sign up now and join the best sand volleyball community in Lake Norman.
      </p>
      <a
        href="https://app.teamlinkt.com/register/find/mattsvolleyball"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary text-xl"
      >
        Register Now
      </a>
    </div>
  </section>
</Layout>

<script>
  const REG_PAGE = 'https://app.teamlinkt.com/register/find/mattsvolleyball';
  const REG_API = '/api/registration';

  interface RegEntry {
    AssociationRegistration: {
      id: number;
      name: string;
      group_name: string;
      open_datetime: string;
      close_datetime: string;
    };
    Season: { id: number; name: string };
  }

  interface SeasonGroup {
    label: string;
    children: {
      [eventType: string]: {
        label: string;
        children: {
          [containerId: string]: {
            label: string;
            children: RegEntry[];
          };
        };
      };
    };
  }

  // Day ordering for sorting registration cards
  const dayOrder: Record<string, number> = { tuesday: 0, wednesday: 1, thursday: 2 };

  function getDayFromName(name: string): string {
    const lower = name.toLowerCase();
    if (lower.includes('tuesday')) return 'tuesday';
    if (lower.includes('wednesday')) return 'wednesday';
    if (lower.includes('thursday')) return 'thursday';
    return 'other';
  }

  const dayColors: Record<string, string> = {
    tuesday: 'bg-coral-500',
    wednesday: 'bg-ocean-500',
    thursday: 'bg-sand-500',
    other: 'bg-ocean-600',
  };

  function formatDate(dateStr: string): string {
    const d = new Date(dateStr.replace(' ', 'T'));
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
  }

  function formatFullDate(dateStr: string): string {
    const d = new Date(dateStr.replace(' ', 'T'));
    return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
  }

  async function loadRegistration() {
    const seasonLoading = document.getElementById('season-loading')!;
    const seasonInfo = document.getElementById('season-info')!;
    const regSection = document.getElementById('reg-section')!;
    const regCards = document.getElementById('reg-cards')!;

    try {
      const res = await fetch(REG_API);
      if (!res.ok) throw new Error('API error');
      const json = await res.json();
      const data: Record<string, SeasonGroup> = json.seasons;
      const seasonDates: { start: string; end: string } | null = json.seasonDates;

      // Get the most recent season (highest season ID)
      const seasonIds = Object.keys(data).sort((a, b) => Number(b) - Number(a));
      if (seasonIds.length === 0) throw new Error('No seasons');

      const seasonId = seasonIds[0];
      const season = data[seasonId];

      // Collect all registration entries
      const entries: RegEntry[] = [];
      for (const eventType of Object.values(season.children)) {
        for (const container of Object.values(eventType.children)) {
          entries.push(...container.children);
        }
      }

      if (entries.length === 0) throw new Error('No registrations');

      // Sort by day of week
      entries.sort((a, b) => {
        const da = dayOrder[getDayFromName(a.AssociationRegistration.name)] ?? 99;
        const db = dayOrder[getDayFromName(b.AssociationRegistration.name)] ?? 99;
        return da - db;
      });

      // Determine overall registration status
      const now = new Date();
      const anyOpen = entries.some((e) => {
        const open = new Date(e.AssociationRegistration.open_datetime.replace(' ', 'T'));
        const close = new Date(e.AssociationRegistration.close_datetime.replace(' ', 'T'));
        return now >= open && now <= close;
      });
      const allFuture = entries.every((e) => {
        const open = new Date(e.AssociationRegistration.open_datetime.replace(' ', 'T'));
        return now < open;
      });

      // Find earliest open and season start from first entry close + a few days
      const earliestOpen = entries.reduce((min, e) => {
        const d = e.AssociationRegistration.open_datetime;
        return d < min ? d : min;
      }, entries[0].AssociationRegistration.open_datetime);

      const latestClose = entries.reduce((max, e) => {
        const d = e.AssociationRegistration.close_datetime;
        return d > max ? d : max;
      }, entries[0].AssociationRegistration.close_datetime);

      // Render season badge + heading
      let badgeHtml = '';
      let subtitleHtml = '';

      const datesLine = seasonDates
        ? `<p class="text-ocean-700 text-lg font-semibold mb-1">${seasonDates.start} – ${seasonDates.end}</p>`
        : '';

      if (anyOpen) {
        badgeHtml = `
          <div class="inline-flex items-center gap-2 bg-sand-200 text-ocean-700 px-4 py-2 rounded-lg font-bold text-sm mb-6">
            <span class="w-2 h-2 bg-ocean-500 rounded-full animate-pulse"></span>
            Registration Open
          </div>`;
        subtitleHtml = `${datesLine}<p class="text-ocean-600/70 text-lg">Registration closes ${formatDate(latestClose)}</p>`;
      } else if (allFuture) {
        badgeHtml = `
          <div class="inline-flex items-center gap-2 bg-sand-200 text-ocean-700 px-4 py-2 rounded-lg font-bold text-sm mb-6">
            Coming Soon
          </div>`;
        subtitleHtml = `${datesLine}<p class="text-ocean-600/70 text-lg">Registration opens ${formatFullDate(earliestOpen)}</p>`;
      } else {
        badgeHtml = `
          <div class="inline-flex items-center gap-2 bg-sand-200 text-ocean-700 px-4 py-2 rounded-lg font-bold text-sm mb-6">
            Registration Closed
          </div>`;
        subtitleHtml = `${datesLine}<p class="text-ocean-600/70 text-lg">Check back for next season</p>`;
      }

      seasonInfo.innerHTML = `
        ${badgeHtml}
        <h2 class="section-heading">${season.label}</h2>
        ${subtitleHtml}
      `;

      // Render registration cards
      regCards.innerHTML = entries.map((e) => {
        const reg = e.AssociationRegistration;
        const day = getDayFromName(reg.name);
        const colorClass = dayColors[day] || dayColors.other;
        const open = new Date(reg.open_datetime.replace(' ', 'T'));
        const close = new Date(reg.close_datetime.replace(' ', 'T'));
        const isOpen = now >= open && now <= close;
        const isFuture = now < open;
        const regUrl = `https://app.teamlinkt.com/register/go/mattsvolleyball/${reg.id}`;

        let statusHtml = '';
        let buttonHtml = '';

        if (isOpen) {
          const daysLeft = Math.ceil((close.getTime() - now.getTime()) / (1000 * 60 * 60 * 24));
          statusHtml = `<span class="text-sm text-ocean-600 font-medium">${daysLeft} day${daysLeft !== 1 ? 's' : ''} left</span>`;
          buttonHtml = `<a href="${regUrl}" target="_blank" rel="noopener noreferrer" class="btn-primary text-center w-full text-sm !py-2">Register</a>`;
        } else if (isFuture) {
          statusHtml = `<span class="text-sm text-ocean-600/70">Opens ${formatDate(reg.open_datetime)}</span>`;
          buttonHtml = `<span class="block text-center w-full text-sm py-2 rounded-lg bg-sand-200 text-ocean-600/70 font-semibold">Coming Soon</span>`;
        } else {
          statusHtml = `<span class="text-sm text-ocean-600/70">Closed ${formatDate(reg.close_datetime)}</span>`;
          buttonHtml = `<span class="block text-center w-full text-sm py-2 rounded-lg bg-sand-200 text-ocean-600/70 font-semibold">Closed</span>`;
        }

        return `
          <div class="card overflow-hidden">
            <div class="${colorClass} px-4 py-3 text-white">
              <span class="font-display font-bold text-sm">${reg.name}</span>
            </div>
            <div class="p-4 flex flex-col gap-3">
              <div class="flex items-center justify-between">
                <span class="text-xs text-ocean-600/70">Closes ${formatDate(reg.close_datetime)}</span>
                ${statusHtml}
              </div>
              ${buttonHtml}
            </div>
          </div>
        `;
      }).join('');

      seasonLoading.classList.add('hidden');
      seasonInfo.classList.remove('hidden');
      regSection.classList.remove('hidden');

    } catch {
      // Fallback: show static info
      seasonLoading.classList.add('hidden');
      seasonInfo.innerHTML = `
        <h2 class="section-heading">Leagues</h2>
        <p class="text-ocean-600/70 text-lg">Visit <a href="${REG_PAGE}" target="_blank" rel="noopener noreferrer" class="underline hover:text-ocean-700">TeamLinkt</a> for current registration info.</p>
      `;
      seasonInfo.classList.remove('hidden');
    }
  }

  loadRegistration();
</script>
