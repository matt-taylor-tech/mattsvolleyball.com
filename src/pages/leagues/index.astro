---
import Layout from '../../layouts/Layout.astro';
import LeagueCard from '../../components/LeagueCard.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const faqItems = [
  {
    question: 'What equipment do I need?',
    answer: 'Bring athletic attire suitable for playing in sand. Mikasa volleyballs are provided, but you\'re welcome to bring your own.',
  },
  {
    question: 'Is it beginner-friendly?',
    answer: 'Absolutely! Matt\'s Volleyball caters to players of all skill levels, including beginners. We have recreational divisions specifically designed for newer players.',
  },
  {
    question: 'How do I form a team?',
    answer: 'You can create your own team and invite friends, or sign up as an individual and we\'ll place you on a team. Either way, you\'ll have a great time.',
  },
  {
    question: 'Can I join multiple teams?',
    answer: 'Yes! You can join multiple teams across different league nights. We do our best to avoid scheduling conflicts when possible.',
  },
  {
    question: 'What time are the games?',
    answer: 'Choose your weekly day. Games start at 6:30, 7:30, 8:30, or 9:30 PM. You\'ll receive your specific game time before the season starts.',
  },
  {
    question: 'Is there an age requirement?',
    answer: 'Players must be at least 21 years old to participate in our leagues.',
  },
  {
    question: 'How much does it cost?',
    answer: '$50 per team plus credit card processing fees. That covers the full season of 6 regular season games plus playoffs.',
  },
  {
    question: 'Are spectators allowed?',
    answer: 'Spectators are welcome and encouraged! Come out, grab some food and drinks, and enjoy the matches.',
  },
  {
    question: 'What happens with bad weather?',
    answer: 'We have an inclement weather / rainout policy. Check our rules page or your TeamLinkt app for updates on any schedule changes.',
  },
];
---

<Layout title="Leagues | Matt's Volleyball" description="Sand volleyball leagues for all skill levels in Lake Norman. Tuesday & Thursday 4v4 leagues, Wednesday shuffle league. Sign up today!">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-ocean-600 to-ocean-800 text-white py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display font-black text-4xl sm:text-5xl md:text-6xl mb-4">Leagues</h1>
      <p class="text-white/80 text-lg md:text-xl max-w-2xl mx-auto">
        Volleyball for grownups who don't take themselves too seriously.
      </p>
    </div>
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full mt-8">
      <path d="M0 40C360 80 720 0 1080 40C1260 60 1380 50 1440 40V80H0V40Z" fill="#F5F0EA" />
    </svg>
  </section>

  <!-- Season Info -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 bg-coral-500/10 text-coral-600 px-4 py-2 rounded-lg font-bold text-sm mb-6">
        <span class="w-2 h-2 bg-coral-500 rounded-full animate-pulse"></span>
        Registration Open
      </div>
      <h2 class="section-heading">Spring 2026</h2>
      <p class="text-ocean-600/70 text-lg">Starts early March, 2026</p>
    </div>
  </section>

  <!-- League Cards -->
  <section class="pb-16 md:pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-3 gap-8">
        <LeagueCard
          day="Tuesday"
          format="4v4"
          description="Maximum 14 teams. Requires 1 female minimum per team. Welcomes all skill levels, typically intermediate to competitive."
          highlight="Two divisions: recreational and competitive with separate playoffs."
          details={[
            '6 regular season games over 6-7 weeks plus 1 playoff week',
            '1 game weekly plus 1 bye week',
            'Form your own team or join as individual',
            'All skill levels welcome',
          ]}
        />

        <LeagueCard
          day="Wednesday"
          format="4v4 Shuffle"
          description="Social focus with volleyball secondary. Individual sign-ups with weekly team redrafts. Meet new people every week!"
          highlight='Level Up format: winning teams advance and receive handicaps, keeping every match competitive.'
          details={[
            'Individual sign-ups. Teams re-drafted each week',
            '6 regular season games plus 1 playoff week',
            'Approximately 2-hour sessions',
            'All skill levels welcome',
          ]}
        />

        <LeagueCard
          day="Thursday"
          format="4v4"
          description="Maximum 14 teams. Identical structure to Tuesday league with 1 female minimum requirement."
          highlight="Two competitive divisions with separate playoffs."
          details={[
            '6 regular season games over 6-7 weeks plus 1 playoff week',
            '1 game weekly plus 1 bye week',
            'Form your own team or join as individual',
            'All skill levels welcome',
          ]}
        />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading text-center mb-12">Frequently Asked Questions</h2>
      <FAQAccordion items={faqItems} />
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-20 bg-sand-200">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-display font-extrabold text-3xl text-ocean-600 mb-4">
        Ready to play?
      </h2>
      <p class="text-ocean-600/80 text-lg mb-8">
        Sign up now and join the best sand volleyball community in Lake Norman.
      </p>
      <a
        href="https://app.teamlinkt.com/register/find/mattsvolleyball"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary text-xl"
      >
        Register Now
      </a>
    </div>
  </section>
</Layout>
