---
import Layout from '../../layouts/Layout.astro';
import { CalendarDays } from 'lucide-astro';
import {
  DIVISIONS,
  ACTIVE_DAYS,
  DAY_FULL_LABEL,
  ACTIVE_SEASON_LABEL,
  UPCOMING_SEASON_LABEL,
  REGISTRATION_PAGE_URL,
} from '../../lib/seasonConfig';
---

<Layout title="Schedule | Matt's Volleyball" description="View the upcoming schedule for all Matt's Volleyball leagues.">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-ocean-600 to-ocean-800 text-white pt-20 md:pt-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display font-black text-4xl sm:text-5xl md:text-6xl mb-4">Schedule</h1>
      <p class="text-white/80 text-lg md:text-xl max-w-2xl mx-auto">
        Upcoming games across all leagues.
      </p>
    </div>
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
      <path d="M0 40C360 80 720 0 1080 40C1260 60 1380 50 1440 40V80H0V40Z" fill="#F7F6F3" />
    </svg>
  </section>

  <section class="py-12 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="mb-6 rounded-xl border border-sand-300 bg-sand-100/70 px-4 py-3 text-sm text-ocean-700">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center rounded-full border border-ocean-300 bg-white px-3 py-1 font-semibold text-ocean-700">
            Current Data: {ACTIVE_SEASON_LABEL}
          </span>
          <a
            href={REGISTRATION_PAGE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-full border border-coral-400 bg-coral-500 px-3 py-1 font-semibold text-white hover:bg-coral-600 transition-colors"
          >
            Upcoming Registration: {UPCOMING_SEASON_LABEL}
          </a>
        </div>
        <p id="schedule-sync" class="mt-2 text-xs text-ocean-600/80">Data fetched from TeamLinkt when this page loads.</p>
      </div>

      <!-- Day Filter -->
      <div class="flex flex-wrap gap-2 mb-3 sm:mb-4" id="day-tabs">
        <button data-day="all" class="tab-btn active">All Days</button>
        {ACTIVE_DAYS.map(day => (
          <button data-day={day} class="tab-btn">{DAY_FULL_LABEL[day] ?? day}</button>
        ))}
      </div>

      <!-- Division Tabs -->
      <div class="flex flex-wrap gap-2 mb-4 sm:mb-8" id="division-tabs">
        <button data-division="all" class="tab-btn active">All</button>
        {DIVISIONS.map(d => (
          <button data-division={d.id} class="tab-btn">{d.label}</button>
        ))}
      </div>

      <!-- Team Search -->
      <div class="mb-4 sm:mb-8">
        <input
          type="text"
          id="team-search"
          placeholder="Search by team name..."
          class="w-full sm:w-72 px-4 py-2 rounded-full border border-sand-300 text-ocean-700 placeholder:text-sand-500 focus:outline-none focus:border-ocean-500 focus:ring-1 focus:ring-ocean-500 text-sm"
        />
      </div>

      <!-- Loading State -->
      <div id="schedule-loading" class="text-center py-12">
        <div class="inline-block w-8 h-8 border-4 border-sand-300 border-t-ocean-600 rounded-full animate-spin"></div>
        <p class="text-ocean-600/70 mt-3">Loading schedule...</p>
      </div>

      <!-- Empty State -->
      <div id="schedule-empty" class="text-center py-12 hidden">
        <CalendarDays class="w-12 h-12 text-sand-400 mx-auto mb-3" />
        <p class="text-ocean-600/70">No upcoming games found.</p>
      </div>

      <!-- Schedule Container -->
      <div id="schedule-container" class="space-y-4 sm:space-y-8 hidden"></div>

      <!-- Tailwind safelist for dynamically rendered classes -->
      <span class="hidden card border-l-4 border-l-coral-500 border-l-emerald-500 border-l-violet-500 border-l-amber-400 bg-ocean-600 bg-coral-500 text-white px-2 py-0.5 rounded-full p-2 flex flex-1 items-center text-ocean-500 text-ocean-600 text-ocean-700 text-ocean-800 text-coral-500 text-xs text-sm font-display font-normal font-semibold font-bold text-lg min-w-0 truncate shrink-0 grid sm:grid-cols-2 sm:col-span-2 gap-2 gap-1.5 mb-1 space-y-4 sm:space-y-8 hover:text-ocean-500 hover:text-ocean-700"></span>

    </div>
  </section>
</Layout>

<style>
  .tab-btn {
    @apply px-3 py-2 rounded-full text-xs sm:text-sm font-medium transition-colors;
    @apply bg-white text-ocean-600 border border-sand-300 hover:bg-sand-50;
  }
  .tab-btn.active {
    @apply bg-ocean-600 text-white border-ocean-600;
  }
</style>

<script>
  import {
    DIVISION_IDS, DIVISIONS_BY_DAY, DAY_FOR_DIVISION, DIVISION_NAME,
    EVENTS_API, TEAMS_API_URL, ACTIVE_SEASON_ID,
    PLAYOFFS_ACTIVE, PLAYOFF_ID,
  } from '../../lib/seasonConfig';

  const API_URL = EVENTS_API;

  let currentDivision = 'all';
  let currentDay = 'all';
  let allGames: GameEvent[] = [];
  let searchQuery = '';
  // Map of division ID → teams
  const teamsByDivision = new Map<string, { id: number; name: string }[]>();

  function setSyncStamp(id: string) {
    const el = document.getElementById(id);
    if (!el) return;
    const stamp = new Date().toLocaleString('en-US', {
      month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit'
    });
    el.textContent = `Data fetched from TeamLinkt at ${stamp}.`;
  }

  function stripHtml(html: string): string {
    const tmp = document.createElement('div');
    tmp.innerHTML = html;
    const span = tmp.querySelector('.tooltips');
    if (span) return span.getAttribute('data-original-title') || span.textContent || '';
    return tmp.textContent || '';
  }

  function extractLocation(html: string): { name: string; url: string } {
    const tmp = document.createElement('div');
    tmp.innerHTML = html;
    const a = tmp.querySelector('a');
    return {
      name: a?.textContent || '',
      url: a?.href || '',
    };
  }

  interface GameEvent {
    date: string;
    time: string;
    home: string;
    away: string;
    homeId: number;
    awayId: number;
    location: { name: string; url: string };
    timestamp: number;
    divisionId: string;
    isPlayoff?: boolean;
  }

  const teamIdToDivision = new Map<number, string>();

  async function fetchAllTeams(): Promise<void> {
    const results = await Promise.all(
      DIVISION_IDS.map(async (id) => {
        const body = new URLSearchParams();
        body.set('group_ids[division]', id);
        body.set('season_id', ACTIVE_SEASON_ID);
        const res = await fetch(TEAMS_API_URL, { method: 'POST', body });
        const teams: { id: number; name: string }[] = await res.json();
        return { id, teams };
      })
    );
    for (const { id, teams } of results) {
      teamsByDivision.set(id, teams.map((t) => ({ id: t.id, name: t.name })));
      for (const t of teams) teamIdToDivision.set(t.id, id);
    }
  }

  async function fetchPlayoffGames(): Promise<GameEvent[]> {
    if (!PLAYOFFS_ACTIVE || !PLAYOFF_ID) return [];
    const body = new URLSearchParams();
    body.set('start', '0');
    body.set('length', '200');
    body.set('status', 'upcoming');
    body.set('schedule_type', 'playoffs');
    body.set('playoff_id', PLAYOFF_ID);
    const res = await fetch(API_URL, { method: 'POST', body });
    const json = await res.json();
    const startOfTodaySec = Math.floor(new Date().setHours(0, 0, 0, 0) / 1000);
    return (json.data || [])
      .filter((row: Record<string, string | number>) => Number(row['6']) >= startOfTodaySec)
      .map((row: Record<string, string | number>) => {
        const homeId = Number(row.home_association_team_id);
        const awayId = Number(row.away_assocation_team_id);
        const divisionId = teamIdToDivision.get(homeId) || teamIdToDivision.get(awayId) || '';
        return {
          date: row['0'] as string,
          time: row['1'] as string,
          home: stripHtml(row['3'] as string),
          away: stripHtml(row['4'] as string),
          homeId,
          awayId,
          location: extractLocation(row['5'] as string),
          timestamp: Number(row['6']),
          divisionId,
          isPlayoff: true,
        };
      });
  }

  function getByeTeams(date: string, games: GameEvent[]): string[] {
    const day = date.split(' ')[0];
    const divisionIds = DIVISIONS_BY_DAY[day];
    if (!divisionIds) return [];

    const divisionsToCheck = currentDivision !== 'all'
      ? divisionIds.filter((id) => id === currentDivision)
      : divisionIds;

    const allTeams = new Map<number, string>();
    for (const id of divisionsToCheck) {
      const teams = teamsByDivision.get(id);
      if (teams) teams.forEach((t) => allTeams.set(t.id, t.name));
    }

    const playingIds = new Set<number>();
    for (const g of games) {
      playingIds.add(g.homeId);
      playingIds.add(g.awayId);
    }

    // The teams endpoint and the schedule can disagree on a team's name
    // (TeamLinkt keeps two name fields), so prefer the name shown in game rows.
    const eventNameById = new Map<number, string>();
    for (const g of allGames) {
      if (g.home) eventNameById.set(g.homeId, g.home);
      if (g.away) eventNameById.set(g.awayId, g.away);
    }

    return [...allTeams]
      .filter(([id]) => !playingIds.has(id))
      .map(([id, name]) => eventNameById.get(id) || name)
      .sort();
  }

  async function fetchDivision(divisionId: string): Promise<GameEvent[]> {
    const body = new URLSearchParams();
    body.set('start', '0');
    body.set('length', '100');
    body.set('status', 'upcoming');
    body.set(`filters[${divisionId}]`, divisionId);

    const res = await fetch(API_URL, { method: 'POST', body });
    const json = await res.json();

    return (json.data || []).map((row: Record<string, string | number>) => ({
      date: row['0'] as string,
      time: row['1'] as string,
      home: stripHtml(row['3'] as string),
      away: stripHtml(row['4'] as string),
      homeId: Number(row.home_association_team_id),
      awayId: Number(row.away_assocation_team_id),
      location: extractLocation(row['5'] as string),
      timestamp: row['6'] as number,
      divisionId,
    }));
  }

  async function fetchAllSchedule(): Promise<GameEvent[]> {
    const startOfTodaySec = Math.floor(new Date().setHours(0, 0, 0, 0) / 1000);
    const [regularResults, playoffGames] = await Promise.all([
      Promise.all(DIVISION_IDS.map(fetchDivision)),
      fetchPlayoffGames(),
    ]);
    const regular = regularResults.flat().filter((g) => g.timestamp >= startOfTodaySec);

    // Deduplicate: if a game appears in both regular and playoff results (same
    // timestamp + home team), keep the playoff copy (which carries isPlayoff=true).
    const playoffKeys = new Set(playoffGames.map((g) => `${g.timestamp}:${g.home}`));
    const deduped = regular.filter((g) => !playoffKeys.has(`${g.timestamp}:${g.home}`));

    return [...deduped, ...playoffGames].sort((a, b) => {
      if (a.timestamp !== b.timestamp) return a.timestamp - b.timestamp;
      const courtA = parseInt(a.location.name.match(/\d+/)?.[0] ?? '0', 10);
      const courtB = parseInt(b.location.name.match(/\d+/)?.[0] ?? '0', 10);
      return courtA - courtB;
    });
  }

  function groupByDate(games: GameEvent[]): Map<string, GameEvent[]> {
    const map = new Map<string, GameEvent[]>();
    for (const game of games) {
      const existing = map.get(game.date) || [];
      existing.push(game);
      map.set(game.date, existing);
    }
    return map;
  }

  function render(games: GameEvent[]) {
    const container = document.getElementById('schedule-container')!;
    const loading = document.getElementById('schedule-loading')!;
    const empty = document.getElementById('schedule-empty')!;

    loading.classList.add('hidden');

    if (games.length === 0) {
      container.classList.add('hidden');
      empty.classList.remove('hidden');
      return;
    }

    empty.classList.add('hidden');
    container.classList.remove('hidden');

    const grouped = groupByDate(games);
    let html = '';

    for (const [date, dateGames] of grouped) {
      html += `
        <div>
          <h3 class="font-display font-bold text-lg text-ocean-600 mb-2 sm:mb-3 flex items-center gap-2">
            <svg class="w-5 h-5 text-ocean-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke-width="2"/>
              <line x1="16" y1="2" x2="16" y2="6" stroke-width="2"/>
              <line x1="8" y1="2" x2="8" y2="6" stroke-width="2"/>
              <line x1="3" y1="10" x2="21" y2="10" stroke-width="2"/>
            </svg>
            ${date}
          </h3>
          <div class="grid sm:grid-cols-2 gap-2">
            ${dateGames.map((g) => {
              const divisionName = DIVISION_NAME[g.divisionId] || '';
              const stripeClass = divisionName.includes('3v3') ? 'border-l-violet-500'
                : divisionName.toLowerCase().includes('rec') ? 'border-l-emerald-500'
                : 'border-l-coral-500';
              const playoffBadge = g.isPlayoff
                ? `<span class="inline-block bg-coral-500 text-white text-xs font-bold px-2 py-0.5 rounded-full shrink-0">PLAYOFFS</span>`
                : '';
              return `
                <div class="card border-l-4 ${stripeClass} p-2">
                  <div class="flex items-center gap-1.5 text-xs text-ocean-500 mb-1">
                    <span class="inline-block bg-ocean-600 text-white font-semibold px-2 py-0.5 rounded-full shrink-0">${g.time.split(' - ')[0]}</span>
                    <a href="${g.location.url}" target="_blank" rel="noopener noreferrer"
                       class="truncate hover:text-ocean-700 transition-colors">${g.location.name.split(' - ')[0]}</a>
                    <span class="text-ocean-400 shrink-0">·</span>
                    <span class="truncate">${divisionName}</span>${playoffBadge}
                  </div>
                  <div class="flex items-center gap-2 text-ocean-800 font-bold">
                    <a href="/leagues/team/?name=${encodeURIComponent(g.home)}" class="truncate hover:text-ocean-500 transition-colors">${g.home}</a>
                    <span class="text-ocean-500 text-xs font-normal shrink-0">vs</span>
                    <a href="/leagues/team/?name=${encodeURIComponent(g.away)}" class="truncate hover:text-ocean-500 transition-colors">${g.away}</a>
                  </div>
                </div>
              `;
            }).join('')}
            ${(() => {
              // Skip bye display for days that are all playoff games
              const allPlayoff = dateGames.every((g) => g.isPlayoff);
              if (allPlayoff) return '';
              const byes = getByeTeams(date, dateGames);
              if (byes.length === 0) return '';
              return `
                <div class="card border-l-4 border-l-amber-400 p-2 sm:col-span-2">
                  <div class="flex items-center gap-2">
                    <span class="inline-block bg-coral-500 text-white text-xs font-bold px-2 py-0.5 rounded-full shrink-0">BYE</span>
                    <div class="flex-1 min-w-0">
                      <div class="text-sm text-ocean-700 font-medium truncate">${byes.join(', ')}</div>
                    </div>
                  </div>
                </div>
              `;
            })()}
          </div>
        </div>
      `;
    }

    container.innerHTML = html;
  }

  function filterAndRender() {
    let filtered = allGames;

    if (currentDay !== 'all') {
      filtered = filtered.filter((g: GameEvent) => g.date.startsWith(currentDay));
    }
    if (currentDivision !== 'all') {
      filtered = filtered.filter((g: GameEvent) => g.divisionId === currentDivision);
    }
    if (searchQuery) {
      const q = searchQuery.toLowerCase();
      filtered = filtered.filter((g: GameEvent) =>
        g.home.toLowerCase().includes(q) || g.away.toLowerCase().includes(q)
      );
    }

    render(filtered);
  }

  async function loadSchedule() {
    const loading = document.getElementById('schedule-loading')!;
    const container = document.getElementById('schedule-container')!;
    const empty = document.getElementById('schedule-empty')!;

    loading.classList.remove('hidden');
    container.classList.add('hidden');
    empty.classList.add('hidden');

    try {
      allGames = await fetchAllSchedule();
      filterAndRender();
      setSyncStamp('schedule-sync');
    } catch {
      loading.classList.add('hidden');
      empty.classList.remove('hidden');
    }
  }

  function updateDivisionVisibility() {
    document.querySelectorAll<HTMLButtonElement>('#division-tabs .tab-btn').forEach((btn) => {
      const div = btn.dataset.division || 'all';
      if (currentDay === 'all' || div === 'all') {
        btn.classList.remove('hidden');
      } else {
        const dayDivisions = DIVISIONS_BY_DAY[currentDay] || [];
        btn.classList.toggle('hidden', !dayDivisions.includes(div));
      }
    });
  }

  function setActiveDay(day: string) {
    currentDay = day;
    document.querySelectorAll<HTMLButtonElement>('#day-tabs .tab-btn').forEach((b) => {
      b.classList.toggle('active', b.dataset.day === day);
    });
  }

  function setActiveDivision(division: string) {
    currentDivision = division;
    document.querySelectorAll<HTMLButtonElement>('#division-tabs .tab-btn').forEach((b) => {
      b.classList.toggle('active', b.dataset.division === division);
    });
  }

  // Day filter clicks - instant, no API call
  document.querySelectorAll<HTMLButtonElement>('#day-tabs .tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      setActiveDay(btn.dataset.day || 'all');
      setActiveDivision('all');
      updateDivisionVisibility();
      filterAndRender();
    });
  });

  // Division tab clicks - instant, no API call
  document.querySelectorAll<HTMLButtonElement>('#division-tabs .tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const div = btn.dataset.division || 'all';
      setActiveDivision(div);
      if (div === 'all') {
        setActiveDay('all');
      } else {
        setActiveDay(DAY_FOR_DIVISION[div]);
      }
      updateDivisionVisibility();
      filterAndRender();
    });
  });

  // Team search
  const searchInput = document.getElementById('team-search') as HTMLInputElement;
  searchInput.addEventListener('input', () => {
    searchQuery = searchInput.value;
    filterAndRender();
  });

  // Teams must load before playoff games (division mapping depends on team IDs).
  // During playoffs, teams are loaded first; regular season runs both in parallel.
  if (PLAYOFFS_ACTIVE) {
    fetchAllTeams().then(() => loadSchedule());
  } else {
    const teamsReady = fetchAllTeams();
    loadSchedule();
    teamsReady.then(() => filterAndRender());
  }
</script>
