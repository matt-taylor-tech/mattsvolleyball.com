---
import Layout from '../../layouts/Layout.astro';
import { ArrowLeft, CalendarDays, ClipboardList } from 'lucide-astro';
---

<Layout title="Team Schedule | Matt's Volleyball" description="View a team's upcoming schedule and past results.">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-ocean-600 to-ocean-800 text-white pt-20 md:pt-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="flex items-center justify-center gap-4 mb-4">
        <img id="team-logo" src="" alt="" class="w-16 h-16 rounded-full object-cover bg-white/20 hidden" />
        <h1 id="team-title" class="font-display font-black text-4xl sm:text-5xl md:text-6xl">Team</h1>
      </div>
      <p id="team-division" class="text-white/80 text-lg md:text-xl max-w-2xl mx-auto"></p>
    </div>
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
      <path d="M0 40C360 80 720 0 1080 40C1260 60 1380 50 1440 40V80H0V40Z" fill="#F7F6F3" />
    </svg>
  </section>

  <section class="py-12 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Back link -->
      <a href="/leagues/teams/" class="inline-flex items-center gap-2 text-ocean-500 hover:text-ocean-700 transition-colors mb-8 text-sm font-medium">
        <ArrowLeft class="w-4 h-4" />
        Back to all teams
      </a>

      <!-- Status Tabs -->
      <div class="flex flex-wrap gap-2 mb-8" id="status-tabs">
        <button data-status="upcoming" class="tab-btn active">Upcoming</button>
        <button data-status="past" class="tab-btn">Results</button>
      </div>

      <!-- Loading State -->
      <div id="team-loading" class="text-center py-12">
        <div class="inline-block w-8 h-8 border-4 border-sand-300 border-t-ocean-600 rounded-full animate-spin"></div>
        <p class="text-ocean-600/70 mt-3">Loading schedule...</p>
      </div>

      <!-- Empty State -->
      <div id="team-empty" class="text-center py-12 hidden">
        <CalendarDays class="w-12 h-12 text-sand-400 mx-auto mb-3" />
        <p class="text-ocean-600/70">No games found.</p>
      </div>

      <!-- Games Container -->
      <div id="games-container" class="space-y-8 hidden"></div>

      <!-- Tailwind safelist for dynamically rendered classes -->
      <span class="hidden card p-4 sm:p-5 flex-col sm:flex-row sm:items-center sm:w-32 text-ocean-500 text-ocean-500/70 text-ocean-600 text-ocean-700 text-xs font-display font-bold text-lg min-w-0 truncate text-coral-500 hover:text-coral-600 font-semibold"></span>

    </div>
  </section>
</Layout>

<style>
  .tab-btn {
    @apply px-3 py-2 rounded-full text-xs sm:text-sm font-medium transition-colors;
    @apply bg-white text-ocean-600 border border-sand-300 hover:bg-sand-50;
  }
  .tab-btn.active {
    @apply bg-ocean-600 text-white border-ocean-600;
  }
</style>

<script>
  const EVENTS_API = 'https://app.mattsvolleyball.com/leagues/getAllEvents/10757';
  const TEAMS_API = 'https://app.mattsvolleyball.com/leagues/getTeams/10757/51955';
  const DIVISION_IDS = ['276787', '276786', '276790', '276788', '276789'];

  const params = new URLSearchParams(window.location.search);
  const teamId = params.get('id') || '';
  const teamName = params.get('name') || '';

  let currentStatus = 'upcoming';

  // Set page title
  if (teamName) {
    document.getElementById('team-title')!.textContent = teamName;
    document.title = `${teamName} | Matt's Volleyball`;
  }

  // Look up team info (image, division) from teams API
  async function loadTeamInfo() {
    if (!teamId && !teamName) return;

    for (const divId of DIVISION_IDS) {
      try {
        const body = new URLSearchParams();
        body.set('group_ids[division]', divId);
        body.set('season_id', '51955');

        const res = await fetch(TEAMS_API, { method: 'POST', body });
        const teams: { id: number; name: string; imageUrl: string; groups: string }[] = await res.json();
        const team = teamId
          ? teams.find((t) => t.id === Number(teamId))
          : teams.find((t) => t.name === teamName);

        if (team) {
          const logo = document.getElementById('team-logo') as HTMLImageElement;
          logo.src = team.imageUrl;
          logo.alt = team.name;
          logo.classList.remove('hidden');
          document.getElementById('team-division')!.textContent = team.groups;
          break;
        }
      } catch {
        // try next division
      }
    }
  }

  function stripHtml(html: string): string {
    const tmp = document.createElement('div');
    tmp.innerHTML = html;
    const span = tmp.querySelector('.tooltips');
    if (span) return span.getAttribute('data-original-title') || span.textContent || '';
    return tmp.textContent || '';
  }

  function extractLink(html: string): string {
    const tmp = document.createElement('div');
    tmp.innerHTML = html;
    const a = tmp.querySelector('a');
    return a?.href || '';
  }

  function extractLocation(html: string): { name: string; url: string } {
    const tmp = document.createElement('div');
    tmp.innerHTML = html;
    const a = tmp.querySelector('a');
    return { name: a?.textContent || '', url: a?.href || '' };
  }

  interface GameEvent {
    date: string;
    time: string;
    home: string;
    away: string;
    summaryUrl: string;
    location: { name: string; url: string };
    timestamp: number;
  }

  async function fetchGames(status: string): Promise<GameEvent[]> {
    const body = new URLSearchParams();
    body.set('start', '0');
    body.set('length', '200');
    body.set('status', status);
    if (status === 'past') {
      body.set('type', 'scores');
      body.set('show_games_only', '1');
    }

    const res = await fetch(EVENTS_API, { method: 'POST', body });
    const json = await res.json();

    const all: GameEvent[] = (json.data || []).map((row: Record<string, string | number>) => ({
      date: row['0'] as string,
      time: row['1'] as string,
      home: stripHtml(row['3'] as string),
      away: stripHtml(row['4'] as string),
      summaryUrl: status === 'past' ? extractLink(row['2'] as string) : '',
      location: extractLocation(row['5'] as string),
      timestamp: row['6'] as number,
    }));

    // Filter to only this team's games
    const name = teamName.toLowerCase();
    const filtered = all.filter(
      (g) => g.home.toLowerCase() === name || g.away.toLowerCase() === name
    );

    return status === 'past' ? filtered.reverse() : filtered;
  }

  function groupByDate(games: GameEvent[]): Map<string, GameEvent[]> {
    const map = new Map<string, GameEvent[]>();
    for (const game of games) {
      const existing = map.get(game.date) || [];
      existing.push(game);
      map.set(game.date, existing);
    }
    return map;
  }

  function render(games: GameEvent[]) {
    const container = document.getElementById('games-container')!;
    const loading = document.getElementById('team-loading')!;
    const empty = document.getElementById('team-empty')!;

    loading.classList.add('hidden');

    if (games.length === 0) {
      container.classList.add('hidden');
      empty.classList.remove('hidden');
      return;
    }

    empty.classList.add('hidden');
    container.classList.remove('hidden');

    const grouped = groupByDate(games);
    const name = teamName.toLowerCase();
    let html = '';

    for (const [date, dateGames] of grouped) {
      html += `
        <div>
          <h3 class="font-display font-bold text-lg text-ocean-600 mb-3 flex items-center gap-2">
            <svg class="w-5 h-5 text-ocean-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke-width="2"/>
              <line x1="16" y1="2" x2="16" y2="6" stroke-width="2"/>
              <line x1="8" y1="2" x2="8" y2="6" stroke-width="2"/>
              <line x1="3" y1="10" x2="21" y2="10" stroke-width="2"/>
            </svg>
            ${date}
          </h3>
          <div class="space-y-3">
            ${dateGames.map((g) => {
              const isHome = g.home.toLowerCase() === name;
              const opponent = isHome ? g.away : g.home;
              const label = isHome ? 'vs' : '@';

              return `
                <div class="card p-4 sm:p-5">
                  <div class="flex flex-col sm:flex-row sm:items-center gap-3">
                    <span class="text-sm font-medium text-ocean-500 sm:w-32 shrink-0">${g.time.replace(' - ', ' \u2013 ')}</span>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2 text-ocean-700 font-medium">
                        <span class="text-ocean-500 text-xs shrink-0">${label}</span>
                        <span class="truncate font-semibold">${opponent}</span>
                      </div>
                      <div class="flex items-center gap-3 mt-1">
                        <a href="${g.location.url}" target="_blank" rel="noopener noreferrer"
                           class="text-sm text-ocean-500/70 hover:text-ocean-600 transition-colors">
                          ${g.location.name}
                        </a>
                        ${g.summaryUrl ? `<a href="${g.summaryUrl}" target="_blank" rel="noopener noreferrer" class="text-sm text-coral-500 hover:text-coral-600 font-medium transition-colors">Summary</a>` : ''}
                      </div>
                    </div>
                  </div>
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `;
    }

    container.innerHTML = html;
  }

  async function loadGames() {
    const loading = document.getElementById('team-loading')!;
    const container = document.getElementById('games-container')!;
    const empty = document.getElementById('team-empty')!;

    loading.classList.remove('hidden');
    container.classList.add('hidden');
    empty.classList.add('hidden');

    try {
      const games = await fetchGames(currentStatus);
      render(games);
    } catch {
      loading.classList.add('hidden');
      empty.classList.remove('hidden');
    }
  }

  // Status tab clicks
  document.querySelectorAll<HTMLButtonElement>('#status-tabs .tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#status-tabs .tab-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      currentStatus = btn.dataset.status || 'upcoming';
      loadGames();
    });
  });

  // Initial load
  loadTeamInfo();
  loadGames();
</script>
