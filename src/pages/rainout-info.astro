---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { Check, X, CircleCheck, CircleX } from 'lucide-astro';
import { GROUPME_MAIN_URL } from '../lib/community';
---

<Layout title="Rainout Info | Matt's Volleyball" description="Matt's Volleyball inclement weather and rainout policy. Learn when games are canceled and how they're rescheduled.">
  <!-- Hero -->
  <PageHero title="Rainout Info" subtitle="Inclement weather policy for league games." />

  <section class="py-12 md:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Main Policy -->
      <div class="bg-ocean-600/5 border-l-4 border-ocean-500 px-6 py-5 rounded-r-lg mb-12">
        <p class="text-ocean-800 text-lg font-semibold leading-relaxed">
          Cancellations due to inclement weather will be decided and posted in the league GroupMe by 5:00 PM on game day. Captains, make sure your team sees the call.
        </p>
      </div>

      <div class="mb-12">
        <h2 class="section-heading mb-4">Rescheduling</h2>
        <p class="text-ocean-700 leading-relaxed">
          Canceled games will be moved to the end of the season's schedule.
        </p>
      </div>

      <!-- Conditions -->
      <div class="grid sm:grid-cols-2 gap-8">
        <!-- Will Play -->
        <div class="card p-6 md:p-8">
          <div class="flex items-center gap-3 mb-4">
            <span class="w-10 h-10 bg-ocean-500 rounded-full flex items-center justify-center text-white">
              <CircleCheck class="w-5 h-5" />
            </span>
            <h2 class="font-display font-bold text-xl text-ocean-600">Will Likely Play In</h2>
          </div>
          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-ocean-700">
              <Check class="w-5 h-5 text-ocean-500 shrink-0 mt-0.5" />
              Light drizzle or moderate rain
            </li>
            <li class="flex items-start gap-3 text-ocean-700">
              <Check class="w-5 h-5 text-ocean-500 shrink-0 mt-0.5" />
              Wet sand from previous rain, but no current rain
            </li>
          </ul>
        </div>

        <!-- Won't Play -->
        <div class="card p-6 md:p-8">
          <div class="flex items-center gap-3 mb-4">
            <span class="w-10 h-10 bg-ocean-700 rounded-full flex items-center justify-center text-white">
              <CircleX class="w-5 h-5" />
            </span>
            <h2 class="font-display font-bold text-xl text-ocean-600">Will NOT Play In</h2>
          </div>
          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-ocean-700">
              <X class="w-5 h-5 text-ocean-700 shrink-0 mt-0.5" />
              Any lightning sightings
            </li>
            <li class="flex items-start gap-3 text-ocean-700">
              <X class="w-5 h-5 text-ocean-700 shrink-0 mt-0.5" />
              Flooded courts
            </li>
            <li class="flex items-start gap-3 text-ocean-700">
              <X class="w-5 h-5 text-ocean-700 shrink-0 mt-0.5" />
              Heavy rain
            </li>
          </ul>
        </div>
      </div>

      <div class="mt-12 bg-sand-100 rounded-2xl p-6 border border-sand-200 text-center">
        <p class="text-ocean-600/80 text-sm">
          Watch the <a href={GROUPME_MAIN_URL} target="_blank" rel="noopener noreferrer" class="text-ocean-600 font-semibold underline hover:text-ocean-500">GroupMe</a> for real-time updates on game day.
        </p>
      </div>
    </div>
  </section>
</Layout>
