---
import Layout from '../layouts/Layout.astro';
import ChampionCard from '../components/ChampionCard.astro';
import { getChampions } from '../lib/champions';
import { getRegistrationData, formatDate, formatFullDate } from '../lib/registration';
import { UPCOMING_DIVISIONS, UPCOMING_MAX_TEAMS_BY_DIVISION, UPCOMING_PLAYER_CAPS_BY_DIVISION, UPCOMING_SEASON_ID, UPCOMING_SEASON_LABEL, UPCOMING_REG_OPEN_DATETIME, UPCOMING_SEASON_START_LABEL, NEXT_NEXT_SEASON_LABEL, ACTIVE_SEASON_LABEL } from '../lib/seasonConfig';
import { Beer, UtensilsCrossed, Umbrella, Music, Users, CalendarDays, Heart } from 'lucide-astro';
import { GROUPME_MAIN_URL, GROUPME_ICON_PATH } from '../lib/community';

const champions = await getChampions();
const { seasonLabel, regStatus, seasonDates, earliestOpen, latestClose, hasOpenRegistration, openRegUrl, openRegIsExternal, openRegDay } = await getRegistrationData({ preferredSeasonId: UPCOMING_SEASON_ID });
const REG_PAGE = 'https://app.teamlinkt.com/register/find/mattsvolleyball';
function countedDivisionsFor(day: string) {
  return UPCOMING_DIVISIONS.filter(
    (d) => d.day === day && (
      d.id in UPCOMING_MAX_TEAMS_BY_DIVISION ||
      d.id in UPCOMING_PLAYER_CAPS_BY_DIVISION
    )
  );
}
const homeDayCounts = {
  Mon: countedDivisionsFor('Mon'),
  Tue: countedDivisionsFor('Tue'),
  Wed: countedDivisionsFor('Wed'),
  Thu: countedDivisionsFor('Thu'),
};
function isPlayerCap(divId: string) {
  return divId in UPCOMING_PLAYER_CAPS_BY_DIVISION;
}
// Hero priority:
//  1. Live TeamLinkt data present (seasonLabel set) -> follow the upcoming
//     season's real registration status (coming-soon -> open -> in-progress).
//  2. No live data yet, but an open date is announced and still in the future
//     -> show a config-driven "coming soon" for the upcoming season.
//  3. Otherwise -> show the active season as in-progress.
// This lets us announce a season before TeamLinkt publishes its forms, then hand
// off to live data automatically once they go public (no manual revert needed).
const now = new Date();
const announcedOpenDate = UPCOMING_REG_OPEN_DATETIME
  ? new Date(UPCOMING_REG_OPEN_DATETIME.replace(' ', 'T'))
  : null;
const showComingSoon = !seasonLabel && announcedOpenDate !== null && now < announcedOpenDate;

const heroRegStatus: 'open' | 'coming-soon' | 'in-progress' | 'closed' =
  seasonLabel ? regStatus : showComingSoon ? 'coming-soon' : 'in-progress';
const heroSeasonLabel = seasonLabel || (showComingSoon ? UPCOMING_SEASON_LABEL : ACTIVE_SEASON_LABEL);
// Open date shown in the hero: live value when available, else the announced date.
const heroEarliestOpen = seasonLabel ? earliestOpen : showComingSoon ? UPCOMING_REG_OPEN_DATETIME : earliestOpen;
const heroRegisterUrl = REG_PAGE;
const heroRegisterTarget = '_blank';
const heroPromoText = hasOpenRegistration
  ? 'Registration closes July 19 · Sign up while all forms are open.'
  : heroRegStatus === 'open' && heroSeasonLabel
  ? `${heroSeasonLabel} registration is open now.`
  : heroRegStatus === 'coming-soon' && heroSeasonLabel
    ? `${heroSeasonLabel} registration opens ${formatFullDate(heroEarliestOpen)}.`
    : heroRegStatus === 'in-progress' && heroSeasonLabel
      ? `Schedules are live. Check the matchups and join the action.`
      : 'League updates land here first.';
const heroDatesText = seasonLabel
  ? 'Season starts the week of July 27 · Runs for 7 weeks plus playoffs.'
  : (showComingSoon && UPCOMING_SEASON_START_LABEL ? `Season starts ${UPCOMING_SEASON_START_LABEL}` : '');
---

<Layout title="Matt's Volleyball | Coed Sand Volleyball in Lake Norman">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-ocean-600 via-ocean-700 to-ocean-800 text-white" data-hero-no-update>
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-20 left-10 w-72 h-72 bg-coral-500 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-10 w-96 h-96 bg-sand-400 rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-12 md:pt-28 md:pb-16 text-center">
      <p class="text-coral-400 font-bold text-sm md:text-base uppercase tracking-widest mb-4">
        Lake Norman's Premier Sand Volleyball League
      </p>
      <h1 class="font-display font-black text-4xl sm:text-5xl md:text-7xl mb-6 leading-tight" data-home-hero-heading>
        {heroRegStatus === 'open' && heroSeasonLabel && (
          <Fragment>Sign Up for<br /><span class="text-coral-400">{heroSeasonLabel.toUpperCase()}!</span></Fragment>
        )}
        {heroRegStatus === 'coming-soon' && heroSeasonLabel && (
          <Fragment><span class="text-coral-400">{heroSeasonLabel.toUpperCase()}</span><br />Is Coming!</Fragment>
        )}
        {heroRegStatus === 'in-progress' && heroSeasonLabel && (
          <Fragment><span class="text-coral-400">{heroSeasonLabel.toUpperCase()}</span><br />Is Underway!</Fragment>
        )}
        {heroRegStatus === 'closed' && heroSeasonLabel && (
          <Fragment><span class="text-coral-400">{NEXT_NEXT_SEASON_LABEL.toUpperCase()}</span><br />Is Coming!</Fragment>
        )}
        {!heroSeasonLabel && (
          <Fragment><span class="text-coral-400">Lake Norman</span><br />Sand Volleyball</Fragment>
        )}
      </h1>
      <p class="text-white/80 text-lg md:text-xl max-w-2xl mx-auto mb-4">
        Get ready to dig, dive, and dominate with Matt's Volleyball - home to the hottest coed sand volleyball leagues in the Lake Norman area!
      </p>
      <p class="text-coral-400 text-xl md:text-2xl font-bold max-w-2xl mx-auto mb-8" data-home-hero-promo>
        {heroPromoText}
      </p>

      <p class:list={['text-white/60 text-sm md:text-base mb-6', !heroDatesText && 'hidden']} data-home-hero-season-dates>
        {heroDatesText}
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center" data-home-hero-cta-group>
        {hasOpenRegistration ? (
          <Fragment>
            <a
              href={heroRegisterUrl}
              target={heroRegisterTarget}
              rel="noopener noreferrer"
              class="btn-primary text-xl py-4 px-10"
            >
              Register Now
            </a>
            <a href="/leagues/schedule/" class="btn-secondary text-xl py-4 px-10">
              View Schedule
            </a>
          </Fragment>
        ) : heroRegStatus === 'open' ? (
          <a
            href={heroRegisterUrl}
            target={heroRegisterTarget}
            rel="noopener noreferrer"
            class="btn-primary text-xl py-4 px-10"
            data-cta-type="register-now"
          >
            Register Now
          </a>
        ) : heroRegStatus === 'coming-soon' ? (
          <Fragment>
            <a
              href="#"
              class="inline-flex items-center gap-2 bg-white/15 backdrop-blur-sm px-8 py-4 rounded-lg font-bold text-lg pointer-events-none opacity-75"
              data-cta-type="register-now"
            >
              Registration Opens {formatFullDate(heroEarliestOpen)}
            </a>
            <a href="/leagues/" class="btn-secondary text-xl py-4 px-10" data-cta-type="view-leagues">
              View Leagues
            </a>
          </Fragment>
        ) : (
          <Fragment>
            <a href="/leagues/schedule/" class="btn-primary text-xl py-4 px-10" data-cta-type="view-schedule">
              View Schedule
            </a>
            <a href="/leagues/" class="btn-secondary text-xl py-4 px-10" data-cta-type="view-leagues">
              View Leagues
            </a>
          </Fragment>
        )}
      </div>
    </div>
    <!-- Wave bottom -->
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
      <path d="M0 40C360 80 720 0 1080 40C1260 60 1380 50 1440 40V80H0V40Z" fill="#F7F6F3" />
    </svg>
  </section>

  <!-- Welcome -->
  <section class="pt-4 pb-12 md:pt-6 md:pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="section-heading">Welcome to Matt's Volleyball</h2>
        <p class="text-ocean-600/80 text-lg leading-relaxed mb-6">
          We play year-round at Saeed's Bar &amp; Grill in Cornelius and Blythe Landing in Huntersville, with leagues and pickup running throughout the week.
        </p>
        <p class="text-ocean-600/80 text-lg leading-relaxed">
          Our leagues are social first, volleyball second. All skill levels welcome - whether you're a seasoned player or picking up a volleyball for the first time.
        </p>
      </div>
    </div>
  </section>

  <!-- Upcoming Games -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading text-center mb-4">Upcoming Games</h2>
      <p class="section-subheading text-center mb-8">Next on the schedule.</p>

      <div id="upcoming-loading" class="text-center py-8">
        <div class="inline-block w-8 h-8 border-4 border-sand-300 border-t-ocean-600 rounded-full animate-spin"></div>
      </div>

      <div id="upcoming-container" class="hidden"></div>

      <div class="text-center mt-6">
        <a href="/leagues/schedule/" class="inline-flex items-center gap-2 text-ocean-600 hover:text-ocean-700 font-semibold transition-colors">
          View Full Schedule
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- Tailwind safelist for dynamically rendered classes -->
      <span class="hidden card border-l-4 border-l-coral-500 border-l-emerald-500 border-l-violet-500 border-l-amber-400 bg-ocean-600 bg-coral-500 text-white text-ocean-400 text-ocean-500 text-ocean-500/70 text-ocean-600 text-ocean-700 text-ocean-800 font-display font-normal font-medium font-semibold font-bold text-sm text-xs truncate sm:grid-cols-2 sm:col-span-2 gap-1.5 gap-2 mb-1 mt-1 px-2 py-0.5 p-2 rounded-full min-w-0 shrink-0 inline-block"></span>
    </div>
  </section>

  <!-- Schedule -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading text-center mb-12">Find Your Night</h2>
      <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-8 max-w-6xl mx-auto">
        <div class="text-center p-8 rounded-2xl bg-sand-50 border border-sand-200">
          <div class="w-16 h-16 bg-emerald-600 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-white font-display font-bold text-lg">Mo</span>
          </div>
          <h3 class="font-display font-bold text-xl text-ocean-600 mb-2">Monday</h3>
          <p class="text-ocean-600/70 text-sm leading-relaxed">
            3v3 coed format with double-headers every night. More reps, more rallies, more fun.
          </p>
          {homeDayCounts.Mon.map((div) => (
            <p
              class="mt-3 text-sm text-ocean-700 opacity-60 italic min-h-[1.25rem]"
              data-team-count-division={div.id}
              data-count-unit={isPlayerCap(div.id) ? 'players' : 'teams'}
              data-division-name={homeDayCounts.Mon.length > 1 ? div.name : null}
            >Checking spots…</p>
          ))}
        </div>

        <div class="text-center p-8 rounded-2xl bg-sand-50 border border-sand-200">
          <div class="w-16 h-16 bg-coral-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-white font-display font-bold text-lg">Tu</span>
          </div>
          <h3 class="font-display font-bold text-xl text-ocean-600 mb-2">Tuesday</h3>
          <p class="text-ocean-600/70 text-sm leading-relaxed">
            4v4 leagues with competitive and recreational divisions. Each division has its own playoff night.
          </p>
          {homeDayCounts.Tue.map((div) => (
            <p
              class="mt-3 text-sm text-ocean-700 opacity-60 italic min-h-[1.25rem]"
              data-team-count-division={div.id}
              data-count-unit={isPlayerCap(div.id) ? 'players' : 'teams'}
              data-division-name={homeDayCounts.Tue.length > 1 ? div.name : null}
            >Checking spots…</p>
          ))}
        </div>

        <div class="text-center p-8 rounded-2xl bg-sand-50 border border-sand-200">
          <div class="w-16 h-16 bg-ocean-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-white font-display font-bold text-lg">We</span>
          </div>
          <h3 class="font-display font-bold text-xl text-ocean-600 mb-2">Wednesday</h3>
          <p class="text-ocean-600/70 text-sm leading-relaxed">
            Shuffle league. Teams are re-drafted each week so you'll meet everyone. Play our Level Up format where winning teams take on progressive handicaps, keeping every match competitive. Plus free prize raffles between games all night long.
          </p>
          <a href="/leagues/shuffle/" class="inline-block mt-3 text-sm font-semibold text-ocean-500 hover:text-ocean-700 transition-colors">
            Learn how shuffle works &rarr;
          </a>
          {homeDayCounts.Wed.map((div) => (
            <p
              class="mt-3 text-sm text-ocean-700 opacity-60 italic min-h-[1.25rem]"
              data-team-count-division={div.id}
              data-count-unit={isPlayerCap(div.id) ? 'players' : 'teams'}
              data-division-name={homeDayCounts.Wed.length > 1 ? div.name : null}
            >Checking spots…</p>
          ))}
        </div>

        <div class="text-center p-8 rounded-2xl bg-sand-50 border border-sand-200">
          <div class="w-16 h-16 bg-sand-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-white font-display font-bold text-lg">Th</span>
          </div>
          <h3 class="font-display font-bold text-xl text-ocean-600 mb-2">Thursday</h3>
          <p class="text-ocean-600/70 text-sm leading-relaxed">
            4v4 leagues with competitive and recreational divisions. Each division has its own playoff night.
          </p>
          {homeDayCounts.Thu.map((div) => (
            <p
              class="mt-3 text-sm text-ocean-700 opacity-60 italic min-h-[1.25rem]"
              data-team-count-division={div.id}
              data-count-unit={isPlayerCap(div.id) ? 'players' : 'teams'}
              data-division-name={homeDayCounts.Thu.length > 1 ? div.name : null}
            >Checking spots…</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Why Play Here -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading text-center mb-4">Why Play Here?</h2>
      <p class="section-subheading text-center mb-12">More than just volleyball. It's a community.</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="text-center p-8">
          <div class="w-14 h-14 bg-sand-200 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <Users class="w-7 h-7 text-ocean-600" />
          </div>
          <h3 class="font-display font-bold text-lg text-ocean-600 mb-2">Inclusive Leagues</h3>
          <p class="text-ocean-600/70 text-sm leading-relaxed">Choose your preferred play style, from casual fun to competitive matches.</p>
        </div>
        <div class="text-center p-8">
          <div class="w-14 h-14 bg-sand-200 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <CalendarDays class="w-7 h-7 text-ocean-600" />
          </div>
          <h3 class="font-display font-bold text-lg text-ocean-600 mb-2">Regular Gamedays</h3>
          <p class="text-ocean-600/70 text-sm leading-relaxed">Join us throughout the week for your dose of beach volleyball excitement.</p>
        </div>
        <div class="text-center p-8">
          <div class="w-14 h-14 bg-sand-200 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <Heart class="w-7 h-7 text-ocean-600" />
          </div>
          <h3 class="font-display font-bold text-lg text-ocean-600 mb-2">Supportive Community</h3>
          <p class="text-ocean-600/70 text-sm leading-relaxed">Make new friends, build lasting memories, and celebrate the spirit of the game.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What to Expect -->
  <section class="py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading text-center mb-4">What to Expect</h2>
      <p class="section-subheading text-center mb-12">It's not just volleyball. It's the full experience.</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="card p-6 text-center">
          <div class="w-12 h-12 bg-sand-200 rounded-xl flex items-center justify-center mx-auto mb-4">
            <Beer class="w-6 h-6 text-ocean-600" />
          </div>
          <h3 class="font-display font-bold text-lg text-ocean-600 mb-2">Drinks</h3>
          <p class="text-ocean-600/70 text-sm leading-relaxed">Raise a toast to victory with handcrafted cocktails and curated beer selection, elevating your sand volleyball experience with every sip.</p>
        </div>
        <div class="card p-6 text-center">
          <div class="w-12 h-12 bg-sand-200 rounded-xl flex items-center justify-center mx-auto mb-4">
            <UtensilsCrossed class="w-6 h-6 text-ocean-600" />
          </div>
          <h3 class="font-display font-bold text-lg text-ocean-600 mb-2">Food</h3>
          <p class="text-ocean-600/70 text-sm leading-relaxed">Savor delicious bites from Saeed's diverse menu, offering a range of tasty treats to satisfy your cravings between sets.</p>
        </div>
        <div class="card p-6 text-center">
          <div class="w-12 h-12 bg-sand-200 rounded-xl flex items-center justify-center mx-auto mb-4">
            <Umbrella class="w-6 h-6 text-ocean-600" />
          </div>
          <h3 class="font-display font-bold text-lg text-ocean-600 mb-2">Courtside Seating</h3>
          <p class="text-ocean-600/70 text-sm leading-relaxed">Experience the action up close where you can feel the energy of the game and cheer on your favorite teams.</p>
        </div>
        <div class="card p-6 text-center">
          <div class="w-12 h-12 bg-sand-200 rounded-xl flex items-center justify-center mx-auto mb-4">
            <Music class="w-6 h-6 text-ocean-600" />
          </div>
          <h3 class="font-display font-bold text-lg text-ocean-600 mb-2">Music</h3>
          <p class="text-ocean-600/70 text-sm leading-relaxed">Groove to <a href="/playlists/" class="text-ocean-500 hover:text-ocean-700 font-medium transition-colors">curated playlists</a> keeping the atmosphere lively and energized throughout the games.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Champions -->
  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="section-heading text-center mb-4">Hall of Champions</h2>
      <p class="section-subheading text-center mb-8">Celebrating our league winners.</p>

      <!-- Horizontal slider -->
      <div class="relative group/slider">
        <div
          id="champions-slider"
          class="flex gap-6 overflow-x-auto scroll-smooth snap-x snap-mandatory pb-4 -mx-4 px-4"
          style="scrollbar-width: thin; scrollbar-color: #C2BFB8 transparent;"
        >
          {champions.map((champ) => (
            <div class="snap-start shrink-0 w-72 sm:w-80">
              <ChampionCard
                teamName={champ.teamName}
                season={champ.season}
                year={champ.year}
                division={champ.division}
                day={champ.day}
                photo={champ.photo}
              />
            </div>
          ))}
        </div>

        <!-- Scroll buttons -->
        <button
          id="champ-prev"
          class="hidden md:flex absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 w-10 h-10 bg-white shadow-lg rounded-full items-center justify-center text-ocean-600 hover:bg-sand-100 transition-colors opacity-0 group-hover/slider:opacity-100"
          aria-label="Scroll left"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          id="champ-next"
          class="hidden md:flex absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 w-10 h-10 bg-white shadow-lg rounded-full items-center justify-center text-ocean-600 hover:bg-sand-100 transition-colors opacity-0 group-hover/slider:opacity-100"
          aria-label="Scroll right"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      <div class="text-center mt-8">
        <a href="/champions/" class="inline-flex items-center gap-2 text-ocean-600 hover:text-ocean-700 font-semibold transition-colors">
          View All Champions
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <script>
    const slider = document.getElementById('champions-slider');
    const prev = document.getElementById('champ-prev');
    const next = document.getElementById('champ-next');
    const scrollAmount = 340;

    prev?.addEventListener('click', () => {
      slider?.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    });
    next?.addEventListener('click', () => {
      slider?.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    });
  </script>

  <script>
    (async () => {
      const loading = document.getElementById('upcoming-loading');
      const container = document.getElementById('upcoming-container');
      if (!loading || !container) return;

      try {
        const { DIVISION_IDS, TEAMS_API_URL, DIVISIONS_BY_DAY, DIVISION_NAME, EVENTS_API, ACTIVE_SEASON_ID } = await import('../lib/seasonConfig');
        const teamsByDivision = new Map<string, string[]>();

        async function fetchAllTeams(): Promise<void> {
          const results = await Promise.allSettled(
            DIVISION_IDS.map(async (id) => {
              const body = new URLSearchParams();
              body.set('group_ids[division]', id);
              body.set('season_id', ACTIVE_SEASON_ID);
              const res = await fetch(TEAMS_API_URL, { method: 'POST', body });
              const teams: { name: string }[] = await res.json();
              return { id, names: teams.map((t) => t.name) };
            })
          );

          for (const result of results) {
            if (result.status !== 'fulfilled') continue;
            teamsByDivision.set(result.value.id, result.value.names);
          }
        }

        function getByeTeams(date: string, games: Array<Record<string, string | number> & { divisionId: string }>): string[] {
          const day = date.split(' ')[0];
          const divisionIds = DIVISIONS_BY_DAY[day];
          if (!divisionIds) return [];

          const allTeams = new Set<string>();
          for (const id of divisionIds) {
            const teams = teamsByDivision.get(id);
            if (teams) teams.forEach((t) => allTeams.add(t));
          }

          if (allTeams.size === 0) return [];

          const playingTeams = new Set<string>();
          for (const g of games) {
            const home = stripHtml(g['3'] as string);
            const away = stripHtml(g['4'] as string);
            playingTeams.add(home);
            playingTeams.add(away);
          }

          return [...allTeams].filter((t) => !playingTeams.has(t)).sort();
        }

        const allGames: Array<Record<string, string | number> & { divisionId: string }> = [];
        const teamsReady = fetchAllTeams();
        await Promise.all([
          teamsReady,
          Promise.all(DIVISION_IDS.map(async (divId) => {
            const body = new URLSearchParams();
            body.set('start', '0');
            body.set('length', '50');
            body.set('status', 'upcoming');
            body.set(`filters[${divId}]`, divId);
            const res = await fetch(EVENTS_API, { method: 'POST', body });
            const json = await res.json();
            for (const row of (json.data || [])) {
              allGames.push({ ...row, divisionId: divId });
            }
          })),
        ]);
        // Show upcoming dates pulled from TeamLinkt and drop stale rows that remain
        // marked as "upcoming" after scores were never entered.
        const startOfTodaySec = Math.floor(new Date().setHours(0, 0, 0, 0) / 1000);
        const upcomingGames = allGames
          .filter((g) => (g['6'] as number) >= startOfTodaySec)
          .sort((a, b) => (a['6'] as number) - (b['6'] as number));

        // Keep the homepage compact by only showing the next few game dates.
        const MAX_DATES_TO_SHOW = 4;
        const allowedDates = new Set<string>();
        for (const game of upcomingGames) {
          if (allowedDates.size >= MAX_DATES_TO_SHOW && !allowedDates.has(game['0'] as string)) {
            continue;
          }
          allowedDates.add(game['0'] as string);
        }
        const games = upcomingGames.filter((g) => allowedDates.has(g['0'] as string));

        if (games.length === 0) {
          loading.classList.add('hidden');
          return;
        }

        function stripHtml(html: string): string {
          const tmp = document.createElement('div');
          tmp.innerHTML = html;
          const span = tmp.querySelector('.tooltips');
          if (span) return span.getAttribute('data-original-title') || span.textContent || '';
          return tmp.textContent || '';
        }

        function extractLocationName(html: string): string {
          const tmp = document.createElement('div');
          tmp.innerHTML = html;
          return tmp.textContent || '';
        }

        // Group by date
        const grouped = new Map<string, typeof games>();
        for (const g of games) {
          const date = g['0'] as string;
          const arr = grouped.get(date) || [];
          arr.push(g);
          grouped.set(date, arr);
        }

        let html = '';
        for (const [date, dateGames] of grouped) {
          const byeTeams = getByeTeams(date, dateGames);
          html += `
            <div class="mb-6">
              <h3 class="font-display font-bold text-sm text-ocean-600 mb-2">${date}</h3>
              <div class="grid sm:grid-cols-2 gap-2">
                ${dateGames.slice().sort((a, b) => {
                  const timeDiff = (a['6'] as number) - (b['6'] as number);
                  if (timeDiff !== 0) return timeDiff;
                  return extractLocationName(a['5'] as string).localeCompare(extractLocationName(b['5'] as string));
                }).map((g) => {
                  const time = (g['1'] as string).split(' - ')[0];
                  const home = stripHtml(g['3'] as string);
                  const away = stripHtml(g['4'] as string);
                  const court = extractLocationName(g['5'] as string).split(' - ')[0];
                  const divisionName = DIVISION_NAME[g.divisionId] || '';
                  const stripeClass = divisionName.includes('3v3') ? 'border-l-violet-500'
                    : divisionName.toLowerCase().includes('rec') ? 'border-l-emerald-500'
                    : 'border-l-coral-500';
                  return `
                    <div class="card border-l-4 ${stripeClass} p-2">
                      <div class="flex items-center gap-1.5 text-xs text-ocean-500 mb-1">
                        <span class="inline-block bg-ocean-600 text-white font-semibold px-2 py-0.5 rounded-full shrink-0">${time}</span>
                        <span class="truncate">${court}</span>
                        <span class="text-ocean-400 shrink-0">·</span>
                        <span class="truncate">${divisionName}</span>
                      </div>
                      <div class="flex items-center gap-2 text-ocean-800 font-bold">
                        <span class="truncate">${home}</span>
                        <span class="text-ocean-500 text-xs font-normal shrink-0">vs</span>
                        <span class="truncate">${away}</span>
                      </div>
                    </div>
                  `;
                }).join('')}
                ${byeTeams.length > 0 ? `
                  <div class="card border-l-4 border-l-amber-400 p-2 sm:col-span-2">
                    <div class="flex items-center gap-2">
                      <span class="inline-block bg-coral-500 text-white text-xs font-bold px-2 py-0.5 rounded-full shrink-0">BYE</span>
                      <div class="flex-1 min-w-0">
                        <div class="text-sm text-ocean-700 font-medium truncate">${byeTeams.join(', ')}</div>
                      </div>
                    </div>
                  </div>
                ` : ''}
              </div>
            </div>
          `;
        }

        loading.classList.add('hidden');
        container.innerHTML = html;
        container.classList.remove('hidden');
      } catch {
        loading.classList.add('hidden');
      }
    })();
  </script>

