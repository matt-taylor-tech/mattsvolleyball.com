---
import Layout from '../layouts/Layout.astro';
---

<Layout title="News | Matt's Volleyball" description="Latest news and updates from Matt's Volleyball sand volleyball leagues in Lake Norman.">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-ocean-600 to-ocean-800 text-white py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display font-black text-4xl sm:text-5xl md:text-6xl mb-4">News</h1>
      <p class="text-white/80 text-lg md:text-xl max-w-2xl mx-auto">
        Updates from Matt's Volleyball.
      </p>
    </div>
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full mt-8">
      <path d="M0 40C360 80 720 0 1080 40C1260 60 1380 50 1440 40V80H0V40Z" fill="#F5F0EA" />
    </svg>
  </section>

  <section class="py-12 md:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="bg-white rounded-2xl shadow-md p-12">
        <svg class="w-16 h-16 mx-auto mb-4 text-sand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
        </svg>
        <h2 class="font-display font-bold text-2xl text-ocean-600 mb-3">Stay Tuned</h2>
        <p class="text-ocean-600/70 leading-relaxed mb-6">
          News and updates will be posted here. In the meantime, follow us on social media for the latest.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a
            href="https://www.facebook.com/groups/mattsvolleyball/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary !py-2 !px-5 !text-sm"
          >
            Facebook Group
          </a>
          <a
            href="https://instagram.com/mattsvolleyball/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary !py-2 !px-5 !text-sm"
          >
            Instagram
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
