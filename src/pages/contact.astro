---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Matt's Volleyball" description="Get in touch with Matt's Volleyball. Whether it's about registration or general inquiries, we're here to help!">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-ocean-600 to-ocean-800 text-white pt-20 md:pt-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-display font-black text-4xl sm:text-5xl md:text-6xl mb-4">Contact Us</h1>
      <p class="text-white/80 text-lg md:text-xl max-w-2xl mx-auto">
        Let's Dig In
      </p>
    </div>
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
      <path d="M0 40C360 80 720 0 1080 40C1260 60 1380 50 1440 40V80H0V40Z" fill="#F7F6F3" />
    </svg>
  </section>

  <section class="py-12 md:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20">
        <!-- Form -->
        <div>
          <h2 class="section-heading mb-2">Send Us a Message!</h2>
          <p class="text-ocean-600/70 mb-8 leading-relaxed">
            Whether it's about registration or general inquiries, we're here to assist you.
            Don't hesitate to get in touch with us, and we'll get back to you as soon as possible!
          </p>

          <div id="success-message" class="hidden bg-ocean-50 border border-ocean-200 rounded-xl p-6 mb-6">
            <h3 class="font-display font-bold text-ocean-700 text-lg mb-1">Message sent!</h3>
            <p class="text-ocean-600/70 text-sm">Thanks for reaching out. We'll get back to you as soon as possible.</p>
          </div>

          <form id="contact-form" action="https://formspree.io/f/xgolbedw" method="POST" class="space-y-6">
            <input type="hidden" name="_next" value="https://mattsvolleyball.com/contact/?thanks" />
            <div>
              <label for="name" class="block text-sm font-semibold text-ocean-700 mb-2">Name *</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-xl border border-sand-300 bg-white
                       focus:outline-none focus:ring-2 focus:ring-ocean-500/50 focus:border-ocean-500
                       transition-colors text-ocean-800 placeholder:text-ocean-600/40"
                placeholder="Your name"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold text-ocean-700 mb-2">Email *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-xl border border-sand-300 bg-white
                       focus:outline-none focus:ring-2 focus:ring-ocean-500/50 focus:border-ocean-500
                       transition-colors text-ocean-800 placeholder:text-ocean-600/40"
                placeholder="your@email.com"
              />
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold text-ocean-700 mb-2">Message *</label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="w-full px-4 py-3 rounded-xl border border-sand-300 bg-white
                       focus:outline-none focus:ring-2 focus:ring-ocean-500/50 focus:border-ocean-500
                       transition-colors text-ocean-800 placeholder:text-ocean-600/40 resize-y"
                placeholder="How can we help you?"
              ></textarea>
            </div>

            <button type="submit" class="btn-primary w-full sm:w-auto">
              Send Message
            </button>
          </form>
        </div>

        <!-- Sidebar -->
        <div class="space-y-8">
          <!-- Venues -->
          <div class="card p-6">
            <h3 class="font-display font-bold text-xl text-ocean-600 mb-4 flex items-center gap-2">
              <svg class="w-6 h-6 text-ocean-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              Where We Play
            </h3>
            <div class="space-y-5 text-ocean-700">
              <div>
                <p class="font-semibold">Saeed's Bar & Grill</p>
                <p class="text-sm text-ocean-600/70 mb-1.5">20832 Catawba Ave, Cornelius, NC 28031</p>
                <div class="flex gap-3 text-sm">
                  <a href="https://maps.google.com/?q=20832+Catawba+Ave,+Cornelius,+NC+28031" target="_blank" rel="noopener noreferrer" class="text-ocean-500 hover:text-ocean-700 font-medium transition-colors">Google Maps</a>
                  <a href="https://maps.apple.com/?address=20832+Catawba+Ave,+Cornelius,+NC+28031" target="_blank" rel="noopener noreferrer" class="text-ocean-500 hover:text-ocean-700 font-medium transition-colors">Apple Maps</a>
                </div>
              </div>
              <div class="border-t border-sand-200 pt-5">
                <p class="font-semibold">Blythe Landing</p>
                <p class="text-sm text-ocean-600/70 mb-1.5">15901 NC-73, Huntersville, NC 28078</p>
                <div class="flex gap-3 text-sm">
                  <a href="https://maps.google.com/?q=15901+NC-73,+Huntersville,+NC+28078" target="_blank" rel="noopener noreferrer" class="text-ocean-500 hover:text-ocean-700 font-medium transition-colors">Google Maps</a>
                  <a href="https://maps.apple.com/?address=15901+NC-73,+Huntersville,+NC+28078" target="_blank" rel="noopener noreferrer" class="text-ocean-500 hover:text-ocean-700 font-medium transition-colors">Apple Maps</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Social -->
          <div class="card p-6">
            <h3 class="font-display font-bold text-xl text-ocean-600 mb-4">Connect With Us</h3>
            <div class="space-y-3">
              <a
                href="https://www.facebook.com/groups/mattsvolleyball/"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 text-ocean-700 hover:text-ocean-500 transition-colors group"
              >
                <div class="w-10 h-10 bg-[#1877F2]/10 group-hover:bg-[#1877F2]/20 rounded-lg flex items-center justify-center transition-colors">
                  <svg class="w-5 h-5 text-[#1877F2]" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" /></svg>
                </div>
                <span class="font-medium">Facebook Group</span>
              </a>
              <a
                href="https://instagram.com/mattsvolleyball/"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 text-ocean-700 hover:text-ocean-500 transition-colors group"
              >
                <div class="w-10 h-10 bg-[#E4405F]/10 group-hover:bg-[#E4405F]/20 rounded-lg flex items-center justify-center transition-colors">
                  <svg class="w-5 h-5 text-[#E4405F]" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" /></svg>
                </div>
                <span class="font-medium">Instagram</span>
              </a>
              <a
                href="https://chat.whatsapp.com/BQmVIkBv1bc7AN7KZlzxjU?mode=r_c"
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 text-ocean-700 hover:text-ocean-500 transition-colors group"
              >
                <div class="w-10 h-10 bg-[#25D366]/10 group-hover:bg-[#25D366]/20 rounded-lg flex items-center justify-center transition-colors">
                  <svg class="w-5 h-5 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" /></svg>
                </div>
                <span class="font-medium">WhatsApp Group</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <script>
    const params = new URLSearchParams(window.location.search);
    if (params.has('thanks')) {
      document.getElementById('success-message')?.classList.remove('hidden');
      document.getElementById('contact-form')?.classList.add('hidden');
      window.history.replaceState({}, '', window.location.pathname);
    }
  </script>
</Layout>
